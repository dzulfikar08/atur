{
  "$schema": "node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off"
  },
  "ignorePatterns": [
    ".wrangler",
    "dist",
    "drizzle",
    "static-app/**",
    "static/**",
    "static-editor/**",
    ".astro/**",
    "**/*.generated.ts"
  ]
}
