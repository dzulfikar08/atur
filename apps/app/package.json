{
  "name": "@atur/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "rm -rf dist .wrangler/deploy .wrangler/tmp && vite build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:drop": "drizzle-kit drop",
    "db:migrate:local": "wrangler d1 execute atur-db --local --file=drizzle/0000_simple_meteorite.sql && wrangler d1 execute atur-db --local --file=seed.sql",
    "db:migrate:remote": "drizzle-kit migrate",
    "cf-typegen": "wrangler types",
    "build:mobile": "vite build --mode mobile",
    "cap:copy": "bun run build:mobile && cap copy",
    "cap:sync": "bun run build:mobile && cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android"
  },
