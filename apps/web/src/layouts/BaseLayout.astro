---
import "../styles/global.css";

// Base layout for the Atur marketing site (diatur.com). Provides the SEO head,
// the site header and footer for content pages (the landing draws its own).
const APP_URL = "https://app.diatur.com";
// Revklik site "Atur" (diatur.com). Cookieless; klikapa.js skips localhost.
const REVKLIK_SITE_ID = "954201cb-3d15-47ae-857b-6e32c79e1f4c";
const year = new Date().getFullYear();

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: string;
  ogImage?: string;
  showChrome?: boolean;
}
const {
  title,
  description,
  canonical,
  ogType = "website",
  ogImage = "/og-atur.webp",
  showChrome = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://diatur.com${canonical}`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={`https://diatur.com${canonical}`} />
    <meta property="og:image" content={`https://diatur.com${ogImage}`} />
    <meta property="og:site_name" content="Atur" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://diatur.com${ogImage}`} />

    <link rel="alternate" type="application/rss+xml" title="Atur Blog" href="/rss.xml" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline defer data-site-id={REVKLIK_SITE_ID} src="https://app.revklik.com/klikapa.js"
    ></script>
    <slot name="head" />
  </head>
  <body>
    {showChrome && (
      <header class="site-header">
        <div class="container header-inner">
          <a class="brand" href="/">
            <img src="/logo.svg" alt="" width="32" height="32" />
            <span>Atur</span>
          </a>
          <nav class="site-nav" aria-label="Site">
            <a href="/#loop">How it works</a>
            <a href="/#phone">Phone app</a>
            <a href="/#pricing">Pricing</a>
            <a href="/blog">Blog</a>
            <a href={APP_URL + "/auth/login"} data-revklik-goal="signin_click" data-revklik-goal-location="header">Sign in</a>
            <a class="btn" href={APP_URL + "/auth/login"} data-revklik-goal="signup_click" data-revklik-goal-location="header">Open workspace</a>
          </nav>
        </div>
      </header>
    )}
    <main>
      <slot />
    </main>
    {showChrome && (
      <footer class="site-footer">
        <div class="container footer-inner">
          <span>© {year} Atur</span>
          <nav class="footer-links" aria-label="Footer">
            <a href="/blog">Blog</a>
            <a href="/privacy">Privacy</a>
            <a href="/support">Support</a>
            <a href="/#phone">Phone beta</a>
          </nav>
        </div>
      </footer>
    )}
  </body>
</html>
