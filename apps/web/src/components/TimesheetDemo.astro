---
import Icon from "./Icon.astro";
// Timesheet demo — a weekly time-entry grid mock. Fully client-side:
// editable hour cells, live totals, week navigation, export button that
// actually downloads a small CSV. No backend.
const weekDays = ["Mon", "Tue", "Wed", "Thu", "Fri"];
const timeRows = [
  { id: "t1", project: "Atur · Checkout fixes", issue: "DEMO-7", color: "#8b5cf6", day: [3, 4, 2, 3, 2] },
  { id: "t2", project: "Atur · Roadmap", issue: "DEMO-9", color: "#3b82f6", day: [2, 1, 2, 0, 3] },
  { id: "t3", project: "Acme · Onboarding", issue: "DEMO-12", color: "#22c55e", day: [1, 2, 3, 2, 1] },
  { id: "t4", project: "Internal · Interviews", issue: "CRM-4", color: "#f59e0b", day: [0, 2, 1, 2, 0] },
];
---
<div class="demo-window time-demo interactive-mock landing-demo">
  <div class="demo-chrome">
    <span class="demo-dots"><i></i><i></i><i></i></span>
    <span class="demo-crumbs">app.diatur.com <i>/</i> demo <i>/</i> <b>timesheet</b></span>
    <span class="demo-status"><i></i>Synced</span>
  </div>

  <div class="time-body">
    <header class="time-head">
      <div>
        <h3 class="time-title"><Icon name="timer" size={18} />Timesheet</h3>
        <p class="time-sub">Week of <b data-week-label>Aug 11 – 15</b></p>
      </div>
      <div class="time-nav">
        <button type="button" class="time-nav-btn" data-week-prev aria-label="Previous week"><Icon name="arrowLeft" size={13} /></button>
        <button type="button" class="time-nav-btn" data-week-next aria-label="Next week"><Icon name="arrowRight" size={13} /></button>
        <button type="button" class="time-export"><Icon name="download" size={13} />CSV</button>
      </div>
    </header>

    <div class="time-summary">
      <div><b class="demo-num" data-total-hours>36.5h</b><span>this week</span></div>
      <div><b class="demo-num" data-entries>19</b><span>entries</span></div>
      <div><b class="demo-num">4</b><span>projects</span></div>
      <div class="time-summary-spark"><i style="height:40%"></i><i style="height:65%"></i><i style="height:45%"></i><i style="height:85%"></i><i style="height:60%"></i></div>
    </div>

    <div class="time-table-wrap">
      <table class="time-table">
        <thead>
          <tr>
            <th class="time-th-project">Project / issue</th>
            {weekDays.map((d, i) => <th class:list={["time-th-day", { "is-today": i === 2 }]}>{d}<i>{(i === 0 ? "11" : i === 1 ? "12" : i === 2 ? "13" : i === 3 ? "14" : "15")}</i></th>)}
            <th class="time-th-total">Total</th>
          </tr>
        </thead>
        <tbody>
          {timeRows.map((r) => (
            <tr data-time-row={r.id}>
              <td class="time-td-project">
                <i style={`background:${r.color}`}></i>
                <div><b>{r.project}</b><span>{r.issue}</span></div>
              </td>
              {r.day.map((h, i) => (
                <td class="time-td-cell">
                  <input
                    type="number"
                    min="0"
                    max="24"
                    step="0.5"
                    value={h}
                    data-hours
                    data-row={r.id}
                    data-day={i}
                    aria-label={`${r.issue} hours on ${weekDays[i]}`}
                  />
                </td>
              ))}
              <td class="time-td-total demo-num" data-row-total={r.id}>{(r.day.reduce((a, b) => a + b, 0))}h</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <footer class="time-foot">
      <span><i class="time-hint-dot"></i> Type in any cell — totals update live.</span>
      <button type="button" class="time-log"><Icon name="plus" size={13} />Log entry</button>
    </footer>
  </div>
</div>

<style>
  .time-body {
    position: relative;
    padding: 20px 22px 16px;
  }
  .time-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .time-title {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    color: var(--demo-text);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .time-title svg {
    color: var(--demo-accent-2);
  }
  .time-sub {
    margin: 3px 0 0;
    color: var(--demo-faint);
    font-size: 11px;
    font-weight: 500;
  }
  .time-sub b {
    color: var(--demo-dim);
    font-weight: 600;
  }
  .time-nav {
    display: flex;
    gap: 6px;
  }
  .time-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 27px;
    height: 27px;
    border: 1px solid var(--demo-hairline-2);
    border-radius: 7px;
    background: var(--demo-panel);
    color: var(--demo-dim);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .time-nav-btn:hover {
    border-color: var(--demo-accent);
    color: var(--demo-accent-2);
  }
  .time-export {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    height: 27px;
    border: 1px solid var(--demo-hairline-2);
    border-radius: 7px;
    background: var(--demo-panel);
    color: var(--demo-dim);
    font-size: 11px;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .time-export:hover {
    border-color: var(--demo-accent);
    color: var(--demo-accent-2);
  }
  .time-summary {
    display: flex;
    align-items: center;
    gap: 26px;
    margin: 18px 0 16px;
    padding: 13px 16px;
    border: 1px solid var(--demo-hairline);
    border-radius: 12px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent);
  }
  .time-summary div b {
    display: block;
    font-size: 21px;
    letter-spacing: -0.02em;
  }
  .time-summary div span {
    color: var(--demo-faint);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .time-summary-spark {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 30px;
    margin-left: auto;
  }
  .time-summary-spark i {
    width: 5px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--demo-accent-2), var(--demo-accent));
    opacity: 0.8;
  }
  .time-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--demo-hairline);
    border-radius: 12px;
  }
  .time-table {
    width: 100%;
    border-collapse: collapse;
  }
  .time-table th {
    padding: 10px 12px;
    color: var(--demo-faint);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
    border-bottom: 1px solid var(--demo-hairline);
  }
  .time-th-day {
    min-width: 72px;
    text-align: center !important;
  }
  .time-th-day i {
    display: block;
    margin-top: 3px;
    color: var(--demo-faint);
    font-size: 9px;
    font-style: normal;
    font-weight: 500;
  }
  .time-th-day.is-today {
    color: var(--demo-accent-2);
  }
  .time-th-day.is-today i {
    color: var(--demo-accent);
  }
  .time-th-total {
    text-align: right !important;
  }
  .time-table td {
    padding: 10px 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 12px;
  }
  .time-td-project {
    min-width: 200px;
  }
  .time-td-project > i {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 10px;
    border-radius: 3px;
    vertical-align: middle;
    box-shadow: 0 0 8px currentColor;
  }
  .time-td-project div {
    display: inline-block;
    vertical-align: middle;
  }
  .time-td-project b {
    display: block;
    color: var(--demo-text);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .time-td-project span {
    display: block;
    margin-top: 1px;
    color: var(--demo-faint);
    font-size: 9.5px;
  }
  .time-td-cell {
    text-align: center;
  }
  .time-td-cell input {
    width: 46px;
    padding: 5px 6px;
    border: 1px solid var(--demo-hairline-2);
    border-radius: 7px;
    background: var(--demo-card);
    color: var(--demo-text);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    text-align: center;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .time-td-cell input:hover {
    border-color: var(--demo-hairline-2);
  }
  .time-td-cell input:focus {
    border-color: var(--demo-accent);
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.18);
  }
  .time-td-total {
    color: var(--demo-accent-2);
    font-weight: 700;
    text-align: right;
  }
  .time-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
    padding-top: 13px;
    border-top: 1px solid var(--demo-hairline);
    color: var(--demo-faint);
    font-size: 10.5px;
  }
  .time-hint-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--demo-amber);
    box-shadow: 0 0 8px rgba(251, 191, 36, 0.5);
  }
  .time-log {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 0;
    border-radius: 8px;
    background: linear-gradient(180deg, var(--demo-accent), #7c3aed);
    color: #fff;
    font-size: 10.5px;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(139, 92, 246, 0.35);
    cursor: pointer;
  }
  .time-log:hover {
    filter: brightness(1.1);
  }
</style>

<script>
  (function () {
    const root = document.querySelector(".time-demo");
    if (!root) return;
    const weekLabel = root.querySelector("[data-week-label]");
    const totalHours = root.querySelector("[data-total-hours]");
    const entriesEl = root.querySelector("[data-entries]");
    const weeks = [
      ["Aug 11 – 15", 36.5, 19],
      ["Aug 18 – 22", 31, 16],
      ["Aug 25 – 29", 40, 21],
    ];
    let weekIdx = 0;

    function fmt(n) {
      return (Math.round(n * 10) / 10).toString().replace(/\.0$/, "") + "h";
    }
    function refresh() {
      let sum = 0;
      let entries = 0;
      root.querySelectorAll("[data-time-row]").forEach((row) => {
        let rowSum = 0;
        row.querySelectorAll("[data-hours]").forEach((inp) => {
          const v = parseFloat(inp.value) || 0;
          rowSum += v;
          if (v > 0) entries++;
        });
        row.querySelector("[data-row-total]").textContent = fmt(rowSum);
        sum += rowSum;
      });
      totalHours.textContent = fmt(sum);
      entriesEl.textContent = entries;
    }
    root.querySelectorAll("[data-hours]").forEach((inp) => {
      inp.addEventListener("change", refresh);
      inp.addEventListener("input", refresh);
    });

    function setWeek(delta) {
      weekIdx = (weekIdx + delta + weeks.length) % weeks.length;
      const [label, total, entries] = weeks[weekIdx];
      weekLabel.textContent = label;
      totalHours.textContent = fmt(total);
      entriesEl.textContent = entries;
      const base = [[3, 4, 2, 3, 2], [2, 1, 2, 0, 3], [1, 2, 3, 2, 1], [0, 2, 1, 2, 0]];
      root.querySelectorAll("[data-hours]").forEach((inp) => {
        const rowIdx = parseInt(inp.dataset.row.replace("t", ""), 10) - 1;
        const dayIdx = parseInt(inp.dataset.day, 10);
        inp.value = base[rowIdx][dayIdx] + (weekIdx === 1 ? 1 : 0);
      });
      refresh();
    }
    root.querySelector("[data-week-prev]").addEventListener("click", () => setWeek(-1));
    root.querySelector("[data-week-next]").addEventListener("click", () => setWeek(1));

    root.querySelector(".time-export").addEventListener("click", () => {
      const rows = [...root.querySelectorAll("[data-time-row]")].map((row) => {
        const project = row.querySelector(".time-td-project b").textContent;
        const issue = row.querySelector(".time-td-project span").textContent;
        const cells = [...row.querySelectorAll("[data-hours]")].map((i) => i.value || "0");
        return [project, issue, ...cells].join(",");
      });
      const csv = "project,issue,mon,tue,wed,thu,fri\n" + rows.join("\n");
      const blob = new Blob([csv], { type: "text/csv" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "timesheet-demo.csv";
      a.click();
      URL.revokeObjectURL(a);
    });
  })();
</script>
