---
// Hero demo: a working model of the Atur web app with sample data. Four tabs
// share one state: answering the agent, changing a state, or letting the live
// pane finish all move the same cards on the board. The screens mirror the
// real app (apps/app/src/client): board columns and cards, issue properties
// with Comments / Activity tabs, the pane view, timesheet agent usage.
// Styles: landing.css ("Hero demo"); data: lib/hero-demo.ts.
import Icon from "./Icon.astro";
import {
  ISSUES,
  PANE_CONTEXT,
  PANE_ISSUE,
  PANE_TITLE,
  STATES,
  agentChipText,
  cardSeq,
  formatCost,
  formatDuration,
  formatHm,
  formatTokens,
  groupUsage,
  usageTotals,
} from "../lib/hero-demo";

const tabs = [
  { id: "board", label: "Board", icon: "kanban", url: "app.diatur.com/atur/projects/web", crumb: "atur / Projects / ATUR" },
  { id: "issue", label: "Issue", icon: "checklist", url: "app.diatur.com/atur/projects/web/issues/35", crumb: "atur / Projects / ATUR / ATUR-35" },
  { id: "pane", label: "Live pane", icon: "terminal", url: "app.diatur.com/panes/atur-42", crumb: "Panes" },
  { id: "usage", label: "Agent usage", icon: "chart", url: "app.diatur.com/atur/timesheet", crumb: "atur / timesheet" },
];

const SELECTED = "ATUR-35";
const sections = groupUsage("agent");
const totals = usageTotals();
const padKey = (key: string) => `ATUR-${key.split("-")[1].padStart(4, "0")}`;
const countOf = (key: string, kind: "comment" | "event") => ISSUES.find((i) => i.key === key)!.thread.filter((e) => e.kind === kind).length;
---

<div class="lp-demo" data-demo>
  <div class="lp-demo-tabs" role="tablist" aria-label="Try the web app">
    {tabs.map((t, i) => (
      <button
        type="button"
        role="tab"
        id={`demo-tab-${t.id}`}
        aria-controls={`demo-${t.id}`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        data-url={t.url}
        data-crumb={t.crumb}
      >
        <Icon name={t.icon} size={16} />{t.label}
      </button>
    ))}
  </div>

  <div class="lp-demo-window">
    <div class="lp-demo-bar" aria-hidden="true">
      <span></span><span></span><span></span>
      <p data-demo-url>{tabs[0].url}</p>
    </div>

    <div class="lp-demo-app" data-app>
      <div class="lp-demo-side" aria-hidden="true">
        <p class="lp-demo-ws"><span>A</span>Atur</p>
        <p class="lp-demo-nav"><Icon name="calendar" size={15} />Today</p>
        <p class="lp-demo-nav"><Icon name="circle" size={15} />My Issues</p>
        <p class="lp-demo-group">Projects</p>
        <p class="lp-demo-nav on" data-side="board issue"><Icon name="kanban" size={15} />Web</p>
        <p class="lp-demo-nav"><Icon name="layers" size={15} />All projects</p>
        <p class="lp-demo-group">Work</p>
        <p class="lp-demo-nav"><Icon name="file" size={15} />Notes</p>
        <p class="lp-demo-nav" data-side="usage"><Icon name="timer" size={15} />Timesheet</p>
        <p class="lp-demo-nav"><Icon name="copy" size={15} />Pages</p>
        <p class="lp-demo-nav" data-side="pane"><Icon name="terminal" size={15} />Panes</p>
        <p class="lp-demo-nav"><Icon name="square" size={15} />Screen</p>
      </div>

      <div class="lp-demo-col-main">
        <div class="lp-demo-top" aria-hidden="true">
          <p class="lp-demo-crumb" data-crumb>{tabs[0].crumb}</p>
          <p class="lp-demo-mhead m-only">
            <span class="lp-demo-wsw"><span>A</span>atur</span>
            <span class="lp-demo-mbtns"><span class="lp-demo-user">DU</span></span>
          </p>
        </div>

        <div class="lp-demo-main">
          <section id="demo-board" role="tabpanel" aria-labelledby="demo-tab-board" class="lp-demo-panel lp-demo-board-panel">
            <div class="lp-demo-toolbar" aria-hidden="true">
              <p class="lp-demo-agents"><span class="lp-demo-dot"></span>2 agents on this board</p>
            </div>
            <div class="lp-demo-board">
              {STATES.map((s) => {
                const cards = ISSUES.filter((i) => i.tone === s.tone);
                const collapsed = s.tone === "done";
                return (
                  <div class={`lp-demo-col lp-tone-${s.tone}`} data-col={s.tone} data-collapsed={collapsed ? "" : undefined}>
                    <div class="lp-demo-col-head">
                      <button type="button" class="lp-demo-sec m-only" data-sec aria-expanded={collapsed ? "false" : "true"} aria-controls={`demo-cards-${s.tone}`} aria-label={`${s.name} issues`}><i class="lp-demo-chev"></i></button>
                      <span class="lp-dot d-only"></span><span class="lp-demo-col-name">{s.name}</span><span class="lp-demo-count" data-count>{cards.length}</span>
                    </div>
                    <div class="lp-demo-cards" id={`demo-cards-${s.tone}`}>
                      {cards.map((issue) => (
                        <button type="button" class:list={["lp-demo-card", { flag: issue.tone === "needs" || issue.tone === "review" }]} data-open={issue.key}>
                          <span class="lp-demo-card-top d-only">
                            <span class="lp-demo-mono" aria-label={issue.key}>{cardSeq(issue.key)}</span>
                            <span class="lp-demo-pdot" data-p={issue.priority.toLowerCase()}></span>
                            <span class="sr-only">Priority: {issue.priority}</span>
                          </span>
                          <span class="lp-demo-card-title">{issue.title}</span>
                          <span class="lp-demo-agent d-only">
                            <Icon name="bot" size={12} />{issue.agent} · <span data-agent-status>{agentChipText(issue.tone)}</span>
                          </span>
                          <span class="lp-demo-av d-only" aria-hidden="true">{issue.agent[0].toUpperCase()}</span>
                          <span class="lp-demo-card-meta m-only">
                            <span class="lp-demo-mono"><span class="sr-only">ATUR-</span>{issue.key.split("-")[1].padStart(4, "0")}</span>
                            <span class="lp-demo-sbadge" data-card-state>{s.name}</span>
                            <span class="lp-demo-ptext"><span class="lp-demo-pdot" data-p={issue.priority.toLowerCase()}></span>{issue.priority.toLowerCase()}</span>
                          </span>
                        </button>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>
          </section>

          <section id="demo-issue" role="tabpanel" aria-labelledby="demo-tab-issue" class="lp-demo-panel" hidden>
            {ISSUES.map((issue) => (
              <article class="lp-demo-issue" data-issue={issue.key} hidden={issue.key !== SELECTED}>
                <header class="lp-demo-issue-head">
                  <p class="lp-demo-path"><span aria-hidden="true">‹</span> <span class="d-only">Web <span aria-hidden="true">›</span></span> <strong class="lp-demo-mono">{padKey(issue.key)}</strong></p>
                  <h3 tabindex="-1">{issue.title}</h3>
                  <p class="lp-demo-body">{issue.body}</p>
                </header>

                <div class="lp-demo-rels" aria-hidden="true">
                  <p class="lp-demo-rel"><strong>Relations (0)</strong></p>
                  <p class="lp-demo-none">No relations</p>
                  <p class="lp-demo-rel d-only"><strong>Sub-issues (0)</strong></p>
                  <p class="lp-demo-none d-only">No sub-issues</p>
                </div>

                <div class="lp-demo-side-pane">
                  <dl class="lp-demo-props">
                    <div>
                      <dt>Assignee</dt>
                      <dd><span class="lp-demo-chip"><span class="lp-demo-av">{issue.agent[0].toUpperCase()}</span>{issue.agent}</span></dd>
                    </div>
                    <div>
                      <dt><label for={`demo-state-${issue.key}`}>State</label></dt>
                      <dd>
                        <span class={`lp-demo-statesel lp-tone-${issue.tone}`} data-statesel>
                          <span class="lp-dot"></span>
                          <select id={`demo-state-${issue.key}`} data-state>
                            {STATES.map((s) => <option value={s.tone} selected={s.tone === issue.tone}>{s.name}</option>)}
                          </select>
                        </span>
                      </dd>
                    </div>
                    <div>
                      <dt>Priority</dt>
                      <dd><span class="lp-demo-pdot" data-p={issue.priority.toLowerCase()}></span>{issue.priority}</dd>
                    </div>
                    <div class="d-only"><dt>Estimate (pts)</dt><dd>None</dd></div>
                    <div class="d-only"><dt>Created</dt><dd class="lp-demo-mono">{issue.created}</dd></div>
                    <div class="d-only"><dt>Updated</dt><dd class="lp-demo-mono" data-updated>{issue.updated}</dd></div>
                  </dl>
                  <p class="lp-demo-dates m-only">Created {issue.created} · Updated <span data-updated>{issue.updated}</span></p>

                  <div class="lp-demo-subtabs d-only" role="tablist" aria-label={`${issue.key} discussion`}>
                    <button type="button" role="tab" id={`demo-sub-comments-${issue.key}`} aria-controls={`demo-subpanel-comments-${issue.key}`} aria-selected="true" data-sub="comments">
                      <Icon name="comment" size={13} /><span>Comments (<span data-tally="comments">{countOf(issue.key, "comment")}</span>)</span>
                    </button>
                    <button type="button" role="tab" id={`demo-sub-activity-${issue.key}`} aria-controls={`demo-subpanel-activity-${issue.key}`} aria-selected="false" tabindex="-1" data-sub="activity">
                      <Icon name="clock" size={13} /><span>Activity (<span data-tally="activity">{countOf(issue.key, "event")}</span>)</span>
                    </button>
                  </div>

                  <div role="tabpanel" id={`demo-subpanel-comments-${issue.key}`} aria-labelledby={`demo-sub-comments-${issue.key}`} data-subpanel="comments">
                    <h4 class="lp-demo-sechead m-only"><Icon name="comment" size={13} /><span>Comments (<span data-tally="comments">{countOf(issue.key, "comment")}</span>)</span></h4>
                    <ol class="lp-demo-thread" data-thread>
                      {issue.thread.filter((e) => e.kind === "comment").map((entry) =>
                        entry.evidence ? (
                          <li class="lp-demo-evidence">
                            <p class="lp-demo-evidence-head">
                              <Icon name="check" size={14} /><strong>{entry.who} posted evidence</strong><span class="lp-demo-mono">{entry.ago}</span>
                            </p>
                            <p>{entry.text}</p>
                            {entry.attach && <span class="lp-demo-attach"><Icon name="image" size={12} />{entry.attach}</span>}
                          </li>
                        ) : (
                          <li class="lp-demo-comment">
                            <span class="lp-demo-avatar" aria-hidden="true">{entry.who[0].toLowerCase()}</span>
                            <div>
                              <p class="lp-demo-comment-head"><strong>{entry.who}</strong><span class="lp-demo-mono">{entry.ago}</span></p>
                              <p>{entry.text}</p>
                            </div>
                          </li>
                        ),
                      )}
                    </ol>
                    <form class="lp-demo-reply" data-reply>
                      <label class="sr-only" for={`demo-reply-${issue.key}`}>Add a comment to {issue.key}</label>
                      <input id={`demo-reply-${issue.key}`} autocomplete="off" placeholder="Add a comment..." />
                      <button type="submit" class="lp-btn lp-btn-primary">Comment</button>
                    </form>
                  </div>

                  <div role="tabpanel" id={`demo-subpanel-activity-${issue.key}`} aria-labelledby={`demo-sub-activity-${issue.key}`} data-subpanel="activity" hidden>
                    <h4 class="lp-demo-sechead m-only"><Icon name="clock" size={13} /><span>Activity (<span data-tally="activity">{countOf(issue.key, "event")}</span>)</span></h4>
                    <ol class="lp-demo-acts" data-acts>
                      {issue.thread.filter((e) => e.kind === "event").map((entry) => (
                        <li>
                          <span class="lp-demo-actdot" aria-hidden="true"></span>
                          <p>
                            {entry.who} changed <strong>State</strong> from <code>{entry.from}</code> to <code>{entry.to}</code> <span class="lp-demo-mono">{entry.ago}</span>
                          </p>
                        </li>
                      ))}
                    </ol>
                  </div>
                </div>
              </article>
            ))}
          </section>

          <section id="demo-pane" role="tabpanel" aria-labelledby="demo-tab-pane" class="lp-demo-panel lp-demo-pane" hidden>
            <div class="lp-demo-pane-head">
              <span class="lp-demo-back" aria-hidden="true">‹</span>
              <div class="lp-demo-pane-title">
                <h3>{PANE_TITLE}</h3>
                <p>{PANE_CONTEXT}</p>
              </div>
              <span class="lp-demo-badge" data-kbd-badge>Read-only</span>
              <button type="button" class="lp-demo-take" data-take>Take keyboard</button>
              <span class="lp-demo-badge lp-demo-badge-live">Live</span>
            </div>
            <p class="lp-demo-ptabs" aria-hidden="true"><Icon name="terminal" size={13} />Terminal</p>
            <div class="lp-demo-term" role="log" aria-label={`${PANE_ISSUE} agent terminal`} data-term></div>
            <form class="lp-demo-composer" data-composer>
              <label class="sr-only" for="demo-composer-input">Message the agent</label>
              <input id="demo-composer-input" autocomplete="off" placeholder="Read-only: take the keyboard to message the agent" disabled data-composer-input />
              <button type="submit" aria-label="Send" disabled><Icon name="send" size={15} /></button>
            </form>
          </section>

          <section id="demo-usage" role="tabpanel" aria-labelledby="demo-tab-usage" class="lp-demo-panel" hidden>
            <div class="lp-demo-usage-head">
              <h3><Icon name="bot" size={15} />AI Agent Usage</h3>
              <span class="lp-demo-mono" data-usage-total>{formatTokens(totals.tokens)} tokens · {formatDuration(totals.seconds)} · {formatCost(totals.cost)}</span>
              <div class="lp-demo-seg" role="group" aria-label="Group by">
                <button type="button" data-group="agent" aria-pressed="true">Agent</button>
                <button type="button" data-group="model" aria-pressed="false">Model</button>
                <button type="button" data-group="issue" aria-pressed="false">Issue</button>
              </div>
            </div>
            <div class="lp-demo-usage" data-usage>
              {sections.map((sec) => (
                <section class="lp-demo-ucard">
                  <div class="lp-demo-uscroll" tabindex="0" role="region" aria-label={`${sec.name} usage`}>
                    <table class="lp-demo-table">
                      <thead>
                        <tr>
                          <th scope="col"><strong>{sec.name}</strong> <span class="lp-demo-mono">{sec.note}</span></th>
                          <th scope="col" class="x">entries</th><th scope="col" class="x">tracked</th><th scope="col" class="x">in</th><th scope="col" class="x">out</th><th scope="col">tokens</th><th scope="col">cost</th>
                        </tr>
                      </thead>
                      <tbody>
                        {sec.rows.map((r) => (
                          <tr>
                            <th scope="row">{r.seq && <span class="lp-demo-mono">{r.seq}</span>}{r.label}</th>
                            <td class="x">{r.entries}</td><td class="x">{formatHm(r.seconds)}</td><td class="x">{formatTokens(r.input)}</td><td class="x">{formatTokens(r.output)}</td><td class="t">{formatTokens(r.input + r.output)}</td><td class="t">{formatCost(r.cost)}</td>
                          </tr>
                        ))}
                      </tbody>
                      <tfoot>
                        <tr>
                          <th scope="row">total</th>
                          <td class="x">{sec.entries}</td><td class="t x">{formatHm(sec.seconds)}</td><td class="x"></td><td class="x"></td><td class="t">{formatTokens(sec.input + sec.output)}</td><td class="t">{formatCost(sec.cost)}</td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </section>
              ))}
            </div>
            <p class="lp-demo-fine">Cost uses Atur's model price table. Agent usage is its own lane, excluded from human totals.</p>
          </section>
        </div>

        <p class="lp-demo-bnav m-only" aria-hidden="true">
          <span><Icon name="grid" size={20} />Home</span>
          <span class="on" data-side="board issue"><Icon name="kanban" size={20} />Projects</span>
          <span><Icon name="circle" size={20} />Issues</span>
          <span><Icon name="search" size={20} />Search</span>
          <span data-side="pane usage"><Icon name="more" size={20} />More</span>
        </p>
      </div>
    </div>
  </div>

  <p class="lp-demo-note">A working model of the web app with sample data. Open a card, answer the agent, approve the proof.</p>
  <p class="sr-only" aria-live="polite" data-announce></p>

  <template data-tpl="comment">
    <li class="lp-demo-comment">
      <span class="lp-demo-avatar" aria-hidden="true"></span>
      <div>
        <p class="lp-demo-comment-head"><strong></strong><span class="lp-demo-mono"></span></p>
        <p></p>
      </div>
    </li>
  </template>
  <template data-tpl="evidence">
    <li class="lp-demo-evidence">
      <p class="lp-demo-evidence-head"><Icon name="check" size={14} /><strong></strong><span class="lp-demo-mono"></span></p>
      <p></p>
    </li>
  </template>
  <template data-tpl="event">
    <li>
      <span class="lp-demo-actdot" aria-hidden="true"></span>
      <p><span data-who></span> changed <strong>State</strong> from <code data-from></code> to <code data-to></code> <span class="lp-demo-mono"></span></p>
    </li>
  </template>
</div>

<script>
  import {
    ISSUES,
    PANE_EVIDENCE,
    PANE_ISSUE,
    PANE_SCRIPT,
    agentChipText,
    formatCost,
    formatHm,
    formatTokens,
    groupUsage,
    stateName,
    type Tone,
    type UsageGroup,
    type UsageSection,
  } from "../lib/hero-demo";

  const root = document.querySelector<HTMLElement>("[data-demo]");
  if (root) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tones = new Map(ISSUES.map((i) => [i.key, i.tone]));
    const agents = new Map(ISSUES.map((i) => [i.key, i.agent]));
    const announce = (text: string) => {
      const el = root.querySelector("[data-announce]");
      if (el) el.textContent = text;
    };
    const issueEl = (key: string) => root.querySelector<HTMLElement>(`[data-issue="${key}"]`)!;
    const crumb = root.querySelector<HTMLElement>(".lp-demo-crumb");

    // The window is as tall as the active screen. Anything that changes the
    // screen runs inside swap(), which eases the height from the old size to
    // the new one instead of jumping.
    const frame = root.querySelector<HTMLElement>("[data-app]")!;
    let swapping = false;
    const swap = (change: () => void) => {
      if (swapping || reduceMotion) return change();
      swapping = true;
      const from = frame.offsetHeight;
      change();
      frame.style.height = "auto";
      const to = frame.offsetHeight;
      swapping = false;
      if (from === to) {
        frame.style.height = "";
        return;
      }
      frame.style.height = `${from}px`;
      void frame.offsetHeight;
      frame.style.height = `${to}px`;
      const done = () => {
        frame.style.height = "";
        frame.removeEventListener("transitionend", done);
      };
      frame.addEventListener("transitionend", done);
      setTimeout(done, 450);
    };

    // ── Tabs (ARIA tabs pattern) ──
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab][data-url]")];
    const url = root.querySelector("[data-demo-url]");
    const tabOpened = new Set<string>();
    const selectTab = (tab: HTMLButtonElement, focus = false) => {
      swap(() => {
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute("aria-controls") ?? "")?.toggleAttribute("hidden", !on);
        }
      });
      const id = tab.id.replace("demo-tab-", "");
      if (url) url.textContent = tab.dataset.url ?? "";
      if (crumb) crumb.textContent = tab.dataset.crumb ?? "";
      root.querySelectorAll<HTMLElement>("[data-side]").forEach((el) => {
        el.classList.toggle("on", (el.dataset.side ?? "").split(" ").includes(id));
      });
      if (focus) tab.focus();
      if (!tabOpened.has(id)) {
        tabOpened.add(id);
        if (id === "pane") runPane();
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        selectTab(tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length], true);
      });
    });
    const tabFor = (id: string) => tabs.find((t) => t.id === `demo-tab-${id}`)!;

    // ── Comments / Activity sub-tabs, one pair per issue ──
    root.querySelectorAll<HTMLElement>("[data-issue]").forEach((el) => {
      const subs = [...el.querySelectorAll<HTMLButtonElement>("[data-sub]")];
      const pick = (sub: HTMLButtonElement, focus = false) => {
        swap(() => {
          for (const s of subs) {
            const on = s === sub;
            s.setAttribute("aria-selected", String(on));
            s.tabIndex = on ? 0 : -1;
            el.querySelector<HTMLElement>(`[data-subpanel="${s.dataset.sub}"]`)!.toggleAttribute("hidden", !on);
          }
        });
        if (focus) sub.focus();
      };
      subs.forEach((sub, i) => {
        sub.addEventListener("click", () => pick(sub));
        sub.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
          e.preventDefault();
          pick(subs[(i + 1) % subs.length], true);
        });
      });
    });

    // ── Thread ──
    const tpl = (name: string) => root.querySelector<HTMLTemplateElement>(`template[data-tpl=${name}]`)!;
    const bump = (key: string, which: "comments" | "activity") => {
      issueEl(key)
        .querySelectorAll<HTMLElement>(`[data-tally=${which}]`)
        .forEach((n) => (n.textContent = String(Number(n.textContent) + 1)));
    };
    const addComment = (key: string, who: string, text: string, agent: boolean, evidence = false) => {
      const li = tpl(evidence ? "evidence" : "comment").content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.querySelector("strong")!.textContent = evidence ? `${who} posted evidence` : who;
      li.querySelector(".lp-demo-mono")!.textContent = "less than a minute ago";
      li.querySelector("p:last-child")!.textContent = text;
      const avatar = li.querySelector(".lp-demo-avatar");
      if (avatar) {
        avatar.textContent = who[0].toLowerCase();
        avatar.classList.toggle("you", !agent);
      }
      issueEl(key).querySelector("[data-thread]")!.append(li);
      bump(key, "comments");
    };
    const addEvent = (key: string, who: string, from: string, to: string) => {
      const li = tpl("event").content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.querySelector("[data-who]")!.replaceWith(who);
      li.querySelector("[data-from]")!.textContent = from;
      li.querySelector("[data-to]")!.textContent = to;
      li.querySelector(".lp-demo-mono")!.textContent = "less than a minute ago";
      issueEl(key).querySelector("[data-acts]")!.append(li);
      bump(key, "activity");
    };

    // ── State changes: card, counts, select and activity move together ──
    const moveIssue = (key: string, to: Tone, who: string) => {
      const from = tones.get(key);
      if (!from || from === to) return;
      tones.set(key, to);
      const card = root.querySelector<HTMLElement>(`[data-open="${key}"]`)!;
      root.querySelector(`[data-col="${to}"] .lp-demo-cards`)!.prepend(card);
      card.classList.toggle("flag", to === "needs" || to === "review");
      card.querySelector("[data-agent-status]")!.textContent = agentChipText(to);
      card.querySelector("[data-card-state]")!.textContent = stateName(to);
      const target = root.querySelector<HTMLElement>(`[data-col="${to}"]`)!;
      target.removeAttribute("data-collapsed");
      target.querySelector("[data-sec]")?.setAttribute("aria-expanded", "true");
      root.querySelectorAll<HTMLElement>("[data-col]").forEach((col) => {
        col.querySelector("[data-count]")!.textContent = String(col.querySelectorAll("[data-open]").length);
      });
      const el = issueEl(key);
      el.querySelector<HTMLSelectElement>("[data-state]")!.value = to;
      const sel = el.querySelector<HTMLElement>("[data-statesel]")!;
      sel.className = `lp-demo-statesel lp-tone-${to}`;
      el.querySelectorAll("[data-updated]").forEach((u) => (u.textContent = "less than a minute ago"));
      addEvent(key, who, stateName(from), stateName(to));
      announce(`${key} moved to ${stateName(to)}`);
    };

    const openIssue = (key: string) => {
      const tab = tabFor("issue");
      tab.dataset.url = `app.diatur.com/atur/projects/web/issues/${key.split("-")[1]}`;
      tab.dataset.crumb = `atur / Projects / ATUR / ${key}`;
      swap(() => {
        root.querySelectorAll<HTMLElement>("[data-issue]").forEach((el) => (el.hidden = el.dataset.issue !== key));
        selectTab(tab);
      });
      issueEl(key).querySelector("h3")?.focus();
    };
    root.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((card) => {
      card.addEventListener("click", () => openIssue(card.dataset.open!));
    });

    root.querySelectorAll<HTMLElement>("[data-issue]").forEach((el) => {
      const key = el.dataset.issue!;
      el.querySelector<HTMLSelectElement>("[data-state]")!.addEventListener("change", (e) => {
        moveIssue(key, (e.target as HTMLSelectElement).value as Tone, "You");
      });
      const form = el.querySelector<HTMLFormElement>("[data-reply]")!;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const input = form.querySelector("input")!;
        const text = input.value.trim();
        if (!text) return;
        input.value = "";
        addComment(key, "You", text, false);
        if (tones.get(key) !== "needs") return;
        // A comment answers a Needs You question; the agent resumes.
        const agent = agents.get(key)!;
        setTimeout(() => {
          addComment(key, agent, "Resuming with your answer.", true);
          moveIssue(key, "started", agent);
        }, reduceMotion ? 0 : 900);
      });
    });

    // ── Phone layout: state sections open and close ──
    root.querySelectorAll<HTMLButtonElement>("[data-sec]").forEach((btn) => {
      btn.addEventListener("click", () => {
        swap(() => {
          const closed = btn.closest("[data-col]")!.toggleAttribute("data-collapsed");
          btn.setAttribute("aria-expanded", String(!closed));
        });
      });
    });

    // ── Live pane: replays one session, then hands the issue to review ──
    const term = root.querySelector<HTMLElement>("[data-term]")!;
    const printLine = (kind: string, text: string) => {
      const p = document.createElement("p");
      if (kind) p.className = kind;
      p.textContent = text;
      term.append(p);
      term.scrollTop = term.scrollHeight;
    };
    const finishPane = () => {
      addComment(PANE_ISSUE, agents.get(PANE_ISSUE)!, PANE_EVIDENCE, true, true);
      moveIssue(PANE_ISSUE, "review", agents.get(PANE_ISSUE)!);
    };
    function runPane() {
      if (reduceMotion) {
        for (const [kind, text] of PANE_SCRIPT) printLine(kind, text);
        finishPane();
        return;
      }
      PANE_SCRIPT.forEach(([kind, text], i) => {
        setTimeout(() => {
          printLine(kind, text);
          if (i === PANE_SCRIPT.length - 1) finishPane();
        }, 450 + i * 700);
      });
    }
    // The pane starts read-only, as in the app: Take keyboard unlocks the composer.
    const composer = root.querySelector<HTMLFormElement>("[data-composer]")!;
    const composerInput = composer.querySelector<HTMLInputElement>("input")!;
    const composerSend = composer.querySelector<HTMLButtonElement>("button")!;
    const take = root.querySelector<HTMLButtonElement>("[data-take]")!;
    const badge = root.querySelector<HTMLElement>("[data-kbd-badge]")!;
    take.addEventListener("click", () => {
      badge.textContent = "Keyboard: yours";
      badge.classList.add("on");
      take.hidden = true;
      composerInput.disabled = false;
      composerSend.disabled = false;
      composerInput.placeholder = "Message the agent…";
      composerInput.focus();
      announce("Keyboard taken. You can message the agent.");
    });
    composer.addEventListener("submit", (e) => {
      e.preventDefault();
      const text = composerInput.value.trim();
      if (!text) return;
      composerInput.value = "";
      printLine("you", `› ${text}`);
      setTimeout(() => printLine("", "Noted. Folding that into ATUR-42."), reduceMotion ? 0 : 600);
    });

    // ── Agent usage grouping ──
    const usageBody = root.querySelector<HTMLElement>("[data-usage]")!;
    const groupButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-group]")];
    // "x" columns (entries, tracked, in, out) drop out on phones.
    const td = (value: string, ...classes: string[]) => {
      const cell = document.createElement("td");
      cell.textContent = value;
      if (classes.length) cell.className = classes.join(" ");
      return cell;
    };
    const mono = (value: string) => {
      const span = document.createElement("span");
      span.className = "lp-demo-mono";
      span.textContent = value;
      return span;
    };
    const renderSection = (sec: UsageSection) => {
      const card = document.createElement("section");
      card.className = "lp-demo-ucard";
      const scroll = document.createElement("div");
      scroll.className = "lp-demo-uscroll";
      scroll.tabIndex = 0;
      scroll.setAttribute("role", "region");
      scroll.setAttribute("aria-label", `${sec.name} usage`);
      const table = document.createElement("table");
      table.className = "lp-demo-table";
      const head = table.createTHead().insertRow();
      const first = document.createElement("th");
      first.scope = "col";
      const strong = document.createElement("strong");
      strong.textContent = sec.name;
      first.append(strong, " ", mono(sec.note));
      head.append(first);
      for (const label of ["entries", "tracked", "in", "out", "tokens", "cost"]) {
        const th = document.createElement("th");
        th.scope = "col";
        th.textContent = label;
        if (label !== "tokens" && label !== "cost") th.className = "x";
        head.append(th);
      }
      const body = table.createTBody();
      for (const r of sec.rows) {
        const tr = body.insertRow();
        const th = document.createElement("th");
        th.scope = "row";
        if (r.seq) th.append(mono(r.seq));
        th.append(r.label);
        tr.append(th, td(String(r.entries), "x"), td(formatHm(r.seconds), "x"), td(formatTokens(r.input), "x"), td(formatTokens(r.output), "x"), td(formatTokens(r.input + r.output), "t"), td(formatCost(r.cost), "t"));
      }
      const foot = table.createTFoot().insertRow();
      const total = document.createElement("th");
      total.scope = "row";
      total.textContent = "total";
      foot.append(total, td(String(sec.entries), "x"), td(formatHm(sec.seconds), "t", "x"), td("", "x"), td("", "x"), td(formatTokens(sec.input + sec.output), "t"), td(formatCost(sec.cost), "t"));
      scroll.append(table);
      card.append(scroll);
      return card;
    };
    groupButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const by = btn.dataset.group as UsageGroup;
        for (const b of groupButtons) b.setAttribute("aria-pressed", String(b === btn));
        swap(() => usageBody.replaceChildren(...groupUsage(by).map(renderSection)));
        announce(`Usage grouped by ${by}`);
      });
    });
  }
</script>
