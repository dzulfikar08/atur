---
import Icon from "./Icon.astro";
// Interactive hero mock — Linear-style product demo, 100% client-side.
// No backend, no data fetching: a draggable kanban board plus an "AI agent"
// tab that replays the agent-loop lifecycle (claim → work → review → done)
// with a fake MCP console. Pure vanilla JS — no dependencies.
const boardTitle = "Q3 Launch";
const boardSubtitle = "Roadmap · Cycle 3 · 8 issues";
const columns = [
  { id: "backlog", label: "Backlog" },
  { id: "inprogress", label: "In Progress" },
  { id: "inreview", label: "In Review" },
  { id: "done", label: "Done" },
];
const cards = [
  { id: "c1", key: "DEMO-9", title: "Q3 roadmap page", prio: "medium", label: "Docs", labelCls: "lbl-docs", avatar: "MK", color: "#22c55e", col: "backlog", comments: 3, agent: true },
  { id: "c2", key: "DEMO-12", title: "Support: password reset flow", prio: "high", label: "Support", labelCls: "lbl-support", avatar: "JT", color: "#14b8a6", col: "backlog", comments: 1, agent: true },
  { id: "c3", key: "DEMO-14", title: "Sync timesheets with payroll", prio: "low", label: "Time", labelCls: "lbl-time", avatar: "SL", color: "#8b5cf6", col: "backlog", comments: 0 },
  { id: "c4", key: "DEMO-7", title: "Fix checkout total on discount codes", prio: "urgent", label: "Bug", labelCls: "lbl-bug", avatar: "AI", color: "#6366f1", col: "backlog", comments: 2, agent: true },
  { id: "c5", key: "DEMO-11", title: "Email notifications for mentions", prio: "high", label: "Feature", labelCls: "lbl-feat", avatar: "MK", color: "#22c55e", col: "inprogress", comments: 4 },
  { id: "c6", key: "DEMO-8", title: "Redesign issue detail sidebar", prio: "medium", label: "Feature", labelCls: "lbl-feat", avatar: "AL", color: "#f59e0b", col: "inreview", comments: 7 },
  { id: "c7", key: "DEMO-3", title: "Onboarding checklist", prio: "low", label: "Docs", labelCls: "lbl-docs", avatar: "JT", color: "#14b8a6", col: "done", comments: 0 },
  { id: "c8", key: "DEMO-5", title: "Drag & drop on mobile", prio: "high", label: "Bug", labelCls: "lbl-bug", avatar: "SL", color: "#8b5cf6", col: "done", comments: 5 },
];
const sidebar = [
  { icon: "kanban", label: "Projects", active: true },
  { icon: "checklist", label: "Issues" },
  { icon: "calendar", label: "Cycles" },
  { icon: "contactBook", label: "CRM" },
  { icon: "file", label: "Pages" },
  { icon: "bot", label: "AI / MCP" },
];
const prioMeta = {
  urgent: ["▲", "#ef4444"],
  high: ["◆", "#f97316"],
  medium: ["●", "#f59e0b"],
  low: ["▾", "#3b82f6"],
};
const navItems = ["Board", "List", "Sheet"];
---
<div class="demo-window interactive-mock" data-mode="board" style="max-width: 1160px; margin: 64px auto 0">
  <div class="demo-chrome">
    <span class="demo-dots"><i></i><i></i><i></i></span>
    <span class="demo-crumbs">app.diatur.com <i>/</i> <b>demo</b> <i>/</i> project board</span>
    <span class="demo-status"><i></i>MCP connected</span>
  </div>

  <div class="board-body">
    <aside class="board-side">
      <div class="board-brand"><Icon name="kanban" size={16} /> <b>Atur</b></div>
      <div class="board-ws"><span class="demo-avatar" style="--bg:#a855f7;width:22px;height:22px;font-size:9px">DV</span><div><b>demo workspace</b><i>Free plan</i></div></div>
      <nav class="board-nav">
        {sidebar.map((item) => (
          <div class:list={["board-nav-item", { active: item.active }]}>
            <Icon name={item.icon} size={16} />{item.label}
          </div>
        ))}
      </nav>
      <div class="board-side-foot"><span class="demo-avatar" style="--bg:#8b5cf6;width:24px;height:24px;font-size:9px">DV</span><div><b>Dev User</b><i>admin</i></div></div>
    </aside>

    <div class="board-main">
      <header class="board-head">
        <div>
          <h3 class="board-title">{boardTitle}</h3>
          <p class="board-sub">{boardSubtitle}</p>
        </div>
        <div class="board-tabs" role="tablist" aria-label="Demo views">
          <button class="board-tab active" type="button" data-tab="board">Kanban board</button>
          <button class="board-tab" type="button" data-tab="agent"><i class="tab-live"></i>AI agent</button>
        </div>
      </header>

      <div class="board-subnav">{navItems.map((n, i) => <span class:list={["board-subnav-item", { active: i === 0 }]}><Icon name={i === 0 ? "kanban" : i === 1 ? "listView" : "grid"} size={13} />{n}</span>)}</div>

      <div class="board-grid" data-board>
        {columns.map((col) => (
          <section class="board-col" data-col={col.id}>
            <header class="board-col-head">
              <span class="board-col-dot"></span>{col.label}
              <i class="board-col-count demo-num" data-count={col.id}>0</i>
            </header>
            <div class="board-col-body">
              {cards.filter((c) => c.col === col.id).map((c) => (
                <article
                  class:list={["board-card", { "is-agent-card": c.agent }]}
                  data-card={c.id}
                  data-key={c.key}
                  style="--d:0.05s"
                >
                  <div class="board-card-top">
                    <span class="board-prio" style={`color:${prioMeta[c.prio][1]}`}>{prioMeta[c.prio][0]}</span>
                    <span class="board-key demo-num">{c.key}</span>
                    {c.agent && <span class="board-label lbl-agent">agent-ready</span>}
                    {!c.agent && <span class:list={["board-label", c.labelCls]}>{c.label}</span>}
                  </div>
                  <h4>{c.title}</h4>
                  <div class="board-card-foot">
                    <span class="demo-avatar" style={`--bg:${c.color};width:18px;height:18px;font-size:8px`}>{c.avatar}</span>
                    {c.comments > 0 && <span class="board-comments demo-num"><Icon name="comment" size={11} />{c.comments}</span>}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Separate terminal window — runs agent-loop.sh like a real user terminal -->
      <div class="term-window" data-termwin>
        <div class="term-chrome">
          <span class="demo-dots"><i></i><i></i><i></i></span>
          <Icon name="terminal" size={13} />
          <b>Terminal — atur</b>
          <span class="term-tag">agent-loop.sh</span>
          <div class="term-right">
            <b class="demo-num" data-progress-label>0/3</b>
            <div class="agent-progress"><i data-progress-bar></i></div>
            <button type="button" class="agent-replay"><Icon name="refresh" size={12} /> Replay</button>
          </div>
        </div>
        <div class="term-log" data-term-log aria-live="polite"></div>
      </div>

      <div class="review-gate" hidden>
        <div class="review-gate-head">
          <div class="review-gate-title">
            <i class="tab-live"></i>
            <b>Code review gate</b>
            <span>spawning reviewer agents…</span>
          </div>
          <div class="review-gate-count demo-num"><b>0</b>/2 approved</div>
        </div>
        <div class="review-gate-reviewers">
          <div class="reviewer" data-reviewer="1">
            <span class="reviewer-avatar">R1</span>
            <div><b>Reviewer 1</b><i class="reviewer-status">spawning…</i></div>
            <em class="reviewer-check"><Icon name="check" size={12} /></em>
          </div>
          <div class="reviewer" data-reviewer="2">
            <span class="reviewer-avatar">R2</span>
            <div><b>Reviewer 2</b><i class="reviewer-status">spawning…</i></div>
            <em class="reviewer-check"><Icon name="check" size={12} /></em>
          </div>
        </div>
        <div class="review-gate-bar"><i data-gate-bar></i></div>
      </div>
    </div>
  </div>
</div>

<style>
  .interactive-mock {
    /* window chrome provided by .demo-window */
  }
  .board-body {
    position: relative;
    display: flex;
    height: 640px;
  }
  .board-side {
    position: relative;
    z-index: 2;
    display: flex;
    width: 190px;
    flex-direction: column;
    padding: 16px 12px;
    border-right: 1px solid var(--demo-hairline);
    background: rgba(12, 12, 16, 0.7);
  }
  .board-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 10px 18px;
    color: var(--demo-accent-2);
    font-size: 15px;
  }
  .board-brand b {
    color: var(--demo-text);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .board-ws {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 6px 14px;
    padding: 9px 10px;
    border: 1px solid var(--demo-hairline);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.02);
  }
  .board-ws b {
    display: block;
    color: var(--demo-text);
    font-size: 11px;
    font-weight: 600;
  }
  .board-ws i {
    display: block;
    margin-top: 1px;
    color: var(--demo-faint);
    font-size: 9.5px;
    font-style: normal;
  }
  .board-nav {
    display: grid;
    gap: 2px;
  }
  .board-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 8px;
    color: var(--demo-dim);
    font-size: 12px;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
  }
  .board-nav-item svg {
    flex: none;
    opacity: 0.75;
  }
  .board-nav-item.active {
    background: linear-gradient(90deg, var(--demo-accent-soft), rgba(255, 255, 255, 0.02));
    color: var(--demo-text);
    box-shadow: inset 0 0 0 1px rgba(139, 92, 246, 0.25);
  }
  .board-nav-item.active svg {
    color: var(--demo-accent-2);
    opacity: 1;
  }
  .board-side-foot {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: auto 6px 0;
    padding: 12px 10px 2px;
    border-top: 1px solid var(--demo-hairline);
  }
  .board-side-foot b {
    display: block;
    font-size: 11px;
    font-weight: 600;
  }
  .board-side-foot i {
    display: block;
    margin-top: 1px;
    color: var(--demo-faint);
    font-size: 9.5px;
    font-style: normal;
  }
  .board-main {
    position: relative;
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: 20px 22px 18px;
  }
  .board-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }
  .board-title {
    margin: 0;
    color: var(--demo-text);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .board-sub {
    margin: 3px 0 0;
    color: var(--demo-faint);
    font-size: 11px;
    font-weight: 500;
  }
  .board-tabs {
    display: flex;
    gap: 3px;
    padding: 3px;
    border: 1px solid var(--demo-hairline-2);
    border-radius: 10px;
    background: var(--demo-panel);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }
  .board-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 13px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--demo-dim);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .board-tab:hover {
    color: var(--demo-text);
  }
  .board-tab.active {
    background: var(--demo-card-2);
    color: var(--demo-text);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }
  .tab-live {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--demo-accent);
    animation: demo-pulse 1.6s ease-in-out infinite;
  }
  .board-subnav {
    display: flex;
    gap: 20px;
    margin: 16px 0 14px;
    border-bottom: 1px solid var(--demo-hairline);
  }
  .board-subnav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding-bottom: 9px;
    color: var(--demo-faint);
    font-size: 11px;
    font-weight: 600;
  }
  .board-subnav-item.active {
    color: var(--demo-text);
  }
  .board-subnav-item.active::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--demo-accent), var(--demo-accent-2));
    content: "";
  }
  .board-grid {
    display: grid;
    flex: 1;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    min-height: 0;
  }
  .board-col {
    display: flex;
    min-height: 0;
    flex-direction: column;
    border: 1px solid var(--demo-hairline);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
    transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .board-col.drop-target {
    border-color: rgba(139, 92, 246, 0.5);
    background: rgba(139, 92, 246, 0.07);
    box-shadow: inset 0 0 0 1px rgba(139, 92, 246, 0.3);
  }
  .board-col.flash {
    animation: board-flash 0.5s ease;
  }
  @keyframes board-flash {
    0% { background: rgba(52, 211, 153, 0.16); border-color: rgba(52, 211, 153, 0.5); }
    100% { background: rgba(255, 255, 255, 0.02); }
  }
  .board-col-head {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 12px 9px;
    color: var(--demo-dim);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .board-col-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--demo-faint);
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.15);
  }
  .board-col[data-col="inprogress"] .board-col-dot { background: var(--demo-amber); }
  .board-col[data-col="inreview"] .board-col-dot { background: var(--demo-accent); }
  .board-col[data-col="done"] .board-col-dot { background: var(--demo-green); }
  .board-col-count {
    margin-left: auto;
    padding: 1px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--demo-faint);
    font-size: 10px;
    font-style: normal;
    font-weight: 700;
  }
  .board-col-body {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-height: 60px;
    padding: 0 9px 10px;
    overflow-y: auto;
  }
  .board-card {
    padding: 11px 13px;
    border: 1px solid var(--demo-hairline-2);
    border-radius: 10px;
    background: linear-gradient(180deg, var(--demo-card), var(--demo-panel-2));
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    cursor: grab;
    touch-action: none;
    user-select: none;
    transition: transform 0.12s, border-color 0.12s, box-shadow 0.12s, opacity 0.12s;
  }
  .board-card:hover {
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }
  .board-card.is-dragging {
    opacity: 0.35;
  }
  .board-card.is-agent-card {
    cursor: default;
  }
  .board-card-top {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .board-prio {
    font-size: 10px;
  }
  .board-key {
    color: var(--demo-faint);
    font-size: 9.5px;
    font-weight: 700;
  }
  .board-label {
    margin-left: auto;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .lbl-bug { background: rgba(239, 68, 68, 0.14); color: var(--demo-red); }
  .lbl-feat { background: rgba(52, 211, 153, 0.14); color: var(--demo-green); }
  .lbl-docs { background: rgba(96, 165, 250, 0.14); color: var(--demo-blue); }
  .lbl-support { background: rgba(45, 212, 191, 0.14); color: var(--demo-teal); }
  .lbl-time { background: rgba(167, 139, 250, 0.14); color: var(--demo-accent-2); }
  .lbl-agent { background: var(--demo-accent-soft); color: var(--demo-accent-2); }
  .board-card h4 {
    margin: 9px 0 0;
    color: var(--demo-text);
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .board-card-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 11px;
  }
  .board-comments {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    color: var(--demo-faint);
    font-size: 10px;
  }
  .drag-ghost {
    z-index: 999;
    width: 230px;
    opacity: 0.94;
    cursor: grabbing;
    transform: rotate(2deg) scale(1.04);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(139, 92, 246, 0.4);
    border-radius: 10px;
  }
  /* --- separate terminal window (floats over the board) --- */
  .term-window {
    position: absolute;
    z-index: 20;
    top: 74px;
    right: 26px;
    width: 430px;
    overflow: hidden;
    border: 1px solid rgba(139, 92, 246, 0.35);
    border-radius: 12px;
    background: #0a0a0e;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.03);
    animation: term-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes term-in {
    from { opacity: 0; transform: translateY(-16px) scale(0.96); }
    to { opacity: 1; transform: none; }
  }
  .term-window.term-done {
    animation: term-out 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes term-out {
    to { opacity: 0; transform: translateY(20px) scale(0.94); }
  }
  .term-chrome {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 13px;
    border-bottom: 1px solid var(--demo-hairline);
    background: linear-gradient(180deg, #15151c, #0e0e13);
  }
  .term-chrome > b {
    color: var(--demo-text);
    font-size: 11px;
    font-weight: 700;
  }
  .term-chrome > svg {
    color: var(--demo-accent-2);
  }
  .term-tag {
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(139, 92, 246, 0.14);
    color: var(--demo-accent-2);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .term-right {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .term-right > b {
    color: var(--demo-faint);
    font-size: 10px;
    font-weight: 600;
  }
  .term-log {
    height: 150px;
    padding: 11px 14px;
    overflow-y: auto;
    font-family: var(--demo-mono);
    font-size: 10.5px;
    line-height: 1.75;
  }
  .term-log .log-line {
    color: var(--demo-text);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .term-log .log-line.dim { color: var(--demo-faint); }
  .term-log .log-line.ok { color: var(--demo-green); }
  .term-log .log-line.warn { color: var(--demo-amber); }
  .log-cursor {
    display: inline-block;
    width: 7px;
    height: 12px;
    margin-left: 3px;
    vertical-align: -2px;
    background: var(--demo-accent);
    animation: demo-blink 0.9s step-end infinite;
  }
  @keyframes demo-blink {
    50% { opacity: 0; }
  }
  /* --- review gate --- */
  .review-gate {
    position: absolute;
    z-index: 21;
    top: 74px;
    left: 26px;
    width: 380px;
    padding: 13px 15px;
    border: 1px solid rgba(139, 92, 246, 0.4);
    border-radius: 12px;
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.12), rgba(20, 20, 26, 0.96));
    animation: gate-in 0.35s ease;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
  }
  @keyframes gate-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .review-gate-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 11px;
  }
  .review-gate-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .review-gate-title b {
    color: var(--demo-text);
    font-size: 11.5px;
  }
  .review-gate-title span {
    color: var(--demo-dim);
    font-size: 10px;
  }
  .review-gate-count {
    color: var(--demo-dim);
    font-size: 10px;
  }
  .review-gate-count b {
    color: var(--demo-green);
    font-size: 12.5px;
  }
  .review-gate-reviewers {
    display: flex;
    gap: 10px;
  }
  .reviewer {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    gap: 10px;
    padding: 9px 11px;
    border: 1px solid var(--demo-hairline-2);
    border-radius: 10px;
    background: var(--demo-card);
    transition: border-color 0.2s;
  }
  .reviewer-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(139, 92, 246, 0.22);
    color: var(--demo-accent-2);
    font-size: 9px;
    font-weight: 700;
  }
  .reviewer div b {
    display: block;
    color: var(--demo-text);
    font-size: 10.5px;
    font-weight: 600;
  }
  .reviewer-status {
    display: block;
    margin-top: 1px;
    color: var(--demo-faint);
    font-size: 9.5px;
    font-style: normal;
  }
  .reviewer-check {
    margin-left: auto;
    color: var(--demo-green);
    font-size: 14px;
    font-style: normal;
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.25s, transform 0.25s;
  }
  .reviewer.approved {
    border-color: rgba(52, 211, 153, 0.4);
  }
  .reviewer.approved .reviewer-check {
    opacity: 1;
    transform: scale(1);
  }
  .reviewer.approved .reviewer-status {
    color: var(--demo-green);
  }
  .reviewer.spawning .reviewer-avatar {
    animation: reviewer-spin 1.1s linear infinite;
  }
  @keyframes reviewer-spin {
    0% { box-shadow: 0 0 0 0 rgba(139, 92, 246, 0.5); }
    50% { box-shadow: 0 0 0 7px rgba(139, 92, 246, 0); }
    100% { box-shadow: 0 0 0 0 rgba(139, 92, 246, 0.5); }
  }
  .review-gate-bar {
    height: 3px;
    margin-top: 11px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
  }
  .review-gate-bar i {
    display: block;
    width: 0%;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #10b981, var(--demo-green));
    transition: width 0.3s ease;
  }
  @media (max-width: 640px) {
    .board-side { display: none; }
    .board-body { height: auto; min-height: 460px; }
    .board-grid { grid-template-columns: repeat(2, 1fr); }
    .board-main { padding: 16px; }
    .term-window {
      top: auto;
      right: 12px;
      bottom: 12px;
      left: 12px;
      width: auto;
    }
  }
</style>

<script>
  (function () {
    const root = document.querySelector(".interactive-mock");
    if (!root) return;
    const board = root.querySelector("[data-board]");
    const cols = [...root.querySelectorAll(".board-col")];
    const colBody = (id) => root.querySelector(`[data-col="${id}"] .board-col-body`);
    const colEl = (id) => root.querySelector(`[data-col="${id}"]`);
    const tabs = [...root.querySelectorAll(".board-tab")];
    const termWin = root.querySelector("[data-termwin]");
    const logEl = root.querySelector("[data-term-log]");
    const replayBtn = root.querySelector(".agent-replay");
    const reviewGate = root.querySelector(".review-gate");
    const reviewers = [...root.querySelectorAll(".reviewer")];
    const gateBar = root.querySelector("[data-gate-bar]");
    const gateCount = root.querySelector(".review-gate-count b");
    const progressBar = root.querySelector("[data-progress-bar]");
    const progressLabel = root.querySelector("[data-progress-label]");

    // ---- column counts ----
    function recount() {
      cols.forEach((col) => {
        const n = col.querySelectorAll(".board-card").length;
        col.querySelector(".board-col-count").textContent = n;
      });
    }
    recount();

    // ---- drag & drop (pointer events; works with mouse + touch) ----
    let drag = null;
    function cardFromEvent(e) {
      return e.target.closest ? e.target.closest(".board-card") : null;
    }
    function makeGhost(card, x, y) {
      const g = card.cloneNode(true);
      g.classList.remove("is-dragging");
      g.classList.add("drag-ghost");
      g.style.position = "fixed";
      g.style.left = "0px";
      g.style.top = "0px";
      g.style.transform = "translate(" + x + "px," + y + "px) rotate(2deg) scale(1.04)";
      g.style.pointerEvents = "none";
      g.style.margin = "0";
      document.body.appendChild(g);
      return g;
    }
    function clearDropTargets() {
      cols.forEach((c) => c.classList.remove("drop-target"));
    }
    function colUnder(x, y) {
      const el = document.elementFromPoint(x, y);
      return el && el.closest ? el.closest(".board-col") : null;
    }
    board.addEventListener("pointerdown", (e) => {
      if (root.dataset.mode !== "board") return;
      const card = cardFromEvent(e);
      if (!card || card.classList.contains("is-agent-card")) return;
      e.preventDefault();
      const rect = card.getBoundingClientRect();
      drag = {
        card,
        offX: e.clientX - rect.left,
        offY: e.clientY - rect.top,
        ghost: makeGhost(card, e.clientX - (e.clientX - rect.left), e.clientY - (e.clientY - rect.top)),
      };
      card.classList.add("is-dragging");
      root.classList.add("dragging");
      moveGhost(e);
    });
    function moveGhost(e) {
      if (!drag) return;
      drag.ghost.style.transform =
        "translate(" + (e.clientX - drag.offX) + "px," + (e.clientY - drag.offY) + "px) rotate(2deg) scale(1.04)";
      clearDropTargets();
      const col = colUnder(e.clientX, e.clientY);
      if (col) col.classList.add("drop-target");
    }
    window.addEventListener("pointermove", moveGhost);
    window.addEventListener("pointerup", (e) => {
      if (!drag) return;
      const { card } = drag;
      const col = colUnder(e.clientX, e.clientY);
      if (col) {
        const target = col.querySelector(".board-col-body");
        const from = card.closest(".board-col");
        target.appendChild(card);
        if (from !== col) {
          col.classList.remove("drop-target");
          col.classList.add("flash");
        }
        recount();
      }
      drag.ghost.remove();
      drag = null;
      clearDropTargets();
      card.classList.remove("is-dragging");
      root.classList.remove("dragging");
    });

    // ---- tab switching ----
    let demoPlayed = false;
    let running = false;
    termWin.hidden = true;
    tabs.forEach((t) => {
      t.addEventListener("click", () => {
        tabs.forEach((x) => x.classList.toggle("active", x === t));
        root.dataset.mode = t.dataset.tab;
        const agentMode = t.dataset.tab === "agent";
        termWin.hidden = !agentMode;
        if (agentMode && !demoPlayed) {
          demoPlayed = true;
          runAgentDemo();
        }
      });
    });
    replayBtn.addEventListener("click", () => {
      if (!running) runAgentDemo();
    });

    // ---- agent-loop demo: drain the whole queue to Done ----
    const agentCardByKey = (key) => root.querySelector(`[data-key="${key}"]`);
    function moveTo(card, colId, flash) {
      colBody(colId).appendChild(card);
      if (flash) {
        const col = colEl(colId);
        col.classList.remove("flash");
        void col.offsetWidth;
        col.classList.add("flash");
      }
      recount();
    }
    function log(cls, text) {
      const line = document.createElement("div");
      line.className = "log-line" + (cls ? " " + cls : "");
      line.textContent = text;
      logEl.appendChild(line);
      logEl.scrollTop = logEl.scrollHeight;
    }
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

    function resetReviewGate() {
      reviewers.forEach((r) => {
        r.classList.remove("approved", "spawning");
        r.querySelector(".reviewer-status").textContent = "spawning…";
      });
      gateBar.style.width = "0%";
      gateCount.textContent = "0";
    }
    function spawnReviewer(el, approveDelay) {
      el.classList.add("spawning");
      return new Promise((resolve) => {
        setTimeout(() => {
          el.classList.remove("spawning");
          el.classList.add("approved");
          el.querySelector(".reviewer-status").textContent = "approved";
          resolve();
        }, approveDelay);
      });
    }
    async function runReviewGate(key) {
      const card = agentCardByKey(key);
      moveTo(card, "inreview", true);
      reviewGate.hidden = false;
      resetReviewGate();
      log("warn", "review " + key + ": spawning 2 parallel reviewer agents (Promise.all)");
      const approveDelay = 1500;
      await Promise.all([
        spawnReviewer(reviewers[0], approveDelay + 300),
        spawnReviewer(reviewers[1], approveDelay),
      ]);
      gateBar.style.width = "100%";
      gateCount.textContent = "2";
      log("ok", "review " + key + ": APPROVED ×2 — gate passed, merging");
      await sleep(600);
      reviewGate.hidden = true;
    }

    async function runAgentDemo() {
      if (running) return;
      running = true;
      replayBtn.disabled = true;
      logEl.innerHTML = "";
      reviewGate.hidden = true;
      progressBar.style.width = "0%";
      progressLabel.textContent = "0/3";
      ["DEMO-7", "DEMO-12", "DEMO-9"].forEach((key) => {
        const c = agentCardByKey(key);
        if (c && !c.closest("[data-col=backlog]")) colBody("backlog").appendChild(c);
      });
      recount();
      log("dim", "$ atur agent-loop.sh --workspace demo");
      log("dim", "poll  label=agent-ready · concurrency=2 · attempts=3 · reviewers=2");
      await sleep(600);

      const queue = [
        { key: "DEMO-7", name: "Fix checkout total on discount codes", files: "3 files", notes: "discount math + tests" },
        { key: "DEMO-12", name: "Support: password reset flow", files: "4 files", notes: "OTP flow + rate limit" },
        { key: "DEMO-9", name: "Q3 roadmap page", files: "2 files", notes: "content + layout" },
      ];
      let doneCount = 0;
      for (let i = 0; i < queue.length; i++) {
        const item = queue[i];
        const card = agentCardByKey(item.key);
        log("", "queue  " + item.key + ": " + item.name + " (state=Todo group=started)");
        await sleep(650);
        log("ok", "claim  " + item.key + " → In Progress (agent@diatur.com)");
        moveTo(card, "inprogress", true);
        await sleep(800);
        log("dim", "mcp__atur__update_issue → state_id: in-progress");
        await sleep(700);
        log("ok", "work   " + item.key + ": wrote fix in " + item.files + " · " + item.notes + " · tests pass");
        await sleep(700);
        await runReviewGate(item.key);
        log("ok", "done   " + item.key + " → Done (supervisor)");
        moveTo(card, "done", true);
        doneCount++;
        progressBar.style.width = Math.round((doneCount / queue.length) * 100) + "%";
        progressLabel.textContent = doneCount + "/" + queue.length;
        await sleep(700);
      }
      log("ok", "queue drained — 3/3 issues shipped. tmux sessions cleaned up.");
      const cursor = document.createElement("span");
      cursor.className = "log-cursor";
      logEl.appendChild(cursor);
      logEl.scrollTop = logEl.scrollHeight;
      await sleep(900);
      // Minimize the terminal like a finished job — reveals the drained board.
      termWin.classList.add("term-done");
      await sleep(500);
      termWin.hidden = true;
      termWin.classList.remove("term-done");
      running = false;
      replayBtn.disabled = false;
    }
  })();
</script>
