---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { ANDROID_CREDIT, ANDROID_PATH, ANDROID_VIEWBOX, APPLE_PATH, APPLE_VIEWBOX } from "../lib/marks";
import "../styles/landing.css";

const APP_URL = "https://app.diatur.com";
const SIGNUP_URL = `${APP_URL}/auth/login`;
const TESTFLIGHT_URL = "https://testflight.apple.com/join/9f11gxvK";
// Android closed test: the Google group is the tester list Play checks, then
// the opt-in page enrolls that Google account.
const TESTER_GROUP_URL = "https://groups.google.com/g/atur-testers";
const TESTER_OPTIN_URL = "https://play.google.com/apps/testing/com.diatur.app";

const androidSteps = [
  "Join the atur-testers Google group with the Google account you use on the Play Store. The group is what opens the closed test to you.",
  "Open the test page on Google Play and tap Become a tester. If the page won't open yet, wait a few minutes and try again.",
  "Install Atur from the Play Store and sign in with the account you use on the web. Your workspaces come with you.",
];

const iosSteps = [
  "Install TestFlight from the App Store if it isn't on your iPhone yet.",
  "Open the Atur TestFlight link on your iPhone and tap Accept.",
  "Tap Install in TestFlight, then sign in with the account you use on the web. Your workspaces come with you.",
];

const MCP_CMD = `claude mcp add atur --transport http https://app.diatur.com/mcp -H "X-API-Key: <your-key>"`;

// The board's own workflow states. Each tint on this page is one of these
// states, so a colour always means the same thing it means in the app.
const loop = [
  {
    tone: "started",
    state: "In Progress",
    title: "An agent claims it",
    body: "It comments that it picked the issue up, links its live pane, and works on a branch in its own worktree.",
  },
  {
    tone: "needs",
    state: "Needs You",
    title: "A stuck agent asks",
    body: "Missing a key or a decision? The issue moves to Needs You with the exact question. Answer in a comment and it carries on.",
  },
  {
    tone: "review",
    state: "Need Review",
    title: "The proof lands on the issue",
    body: "What changed, the test run, and a screenshot for UI work, posted where you will read it.",
  },
  {
    tone: "done",
    state: "Done",
    title: "You merge",
    body: "Agents leave a branch or open a PR. Merging stays with you unless you switch on auto-merge for that workspace.",
  },
];

const facts = [
  ["70+", "MCP tools for Claude, Codex, Cursor and any MCP client"],
  ["$29/mo", "Team plan, for the whole team, not per seat"],
  ["Web + phone", "iPhone and Android apps in public testing"],
  ["Need Review", "where every agent task stops for you"],
];

const paneSteps = [
  ["Open the pane", "Every claim links to its pane. It opens read-only, so a stray tap types nothing."],
  ["Take the keyboard", "Ctrl, Esc, Tab and the arrows sit above the phone keyboard. Fit width scales a wide terminal to your screen."],
  ["Type or talk", "The prompt box sends a whole message at once. In the app, dictation runs on the phone."],
];

const extras = [
  { icon: "calendar", title: "Sprints and modules", body: "Plan a cycle, group issues into modules, and watch progress per sprint.", href: "/blog/ai-sprint-planning" },
  { icon: "lifeBuoy", title: "Support portal", body: "Customers file tickets in your portal. Triage them into issues an agent can take.", href: "/blog/ai-ticket-triage" },
  { icon: "comment", title: "Feedback board", body: "A public board where customers post and vote, linked to the work that answers them.", href: "/blog/customer-feedback-loop" },
  { icon: "timer", title: "Time and billable hours", body: "Log time on issues by hand or with a timer, and roll it up per project.", href: "/blog/track-billable-hours" },
  { icon: "money", title: "Sales pipeline", body: "Deals move through stages like issues do. Connect Polar and paying customers arrive as contacts.", href: "/blog/sales-pipeline-stages" },
  { icon: "slidersHorizontal", title: "Custom fields", body: "Text, number, date, select, user and currency fields on any project.", href: null },
];

const promises = [
  ["gitPullRequest", "Agents do not merge", "By default an agent's work ends at a branch or a PR. You choose when it ships."],
  ["userMultiple", "One price for the team", "Team is $29 a month for everyone in the workspace. Adding a person costs nothing."],
  ["trash", "Leave with your data", "Delete a workspace or your whole account from settings, on the web or in the app."],
];

const plans = [
  {
    name: "Starter",
    price: "$9",
    blurb: "For individuals and small teams building a calmer operating system.",
    items: ["Projects, issues, and cycles", "Support portal and feedback", "CRM contacts and pipeline", "Pages and knowledge graph", "Time tracking", "AI agents via MCP"],
    cta: "Start with Starter",
    team: false,
  },
  {
    name: "Team",
    price: "$29",
    blurb: "For growing teams bringing delivery and customer work together.",
    items: ["Everything in Starter", "Flat price: the whole team, not per seat", "Custom domain", "Daily automatic backups", "Priority support", "Onboarding assistance"],
    cta: "Start with Team",
    team: true,
  },
];

const posts = [
  ["why-we-built-atur", "Why we built Atur", "Small teams don't fail from lack of tools. They fail from context scattered across too many of them."],
  ["project-management-for-ai-agents", "Project management for AI agent crews", "How issues, states and evidence change when some of your teammates are agents."],
  ["atur-vs-linear", "Atur vs Linear", "Linear made issues fast. Atur makes issues something an agent can pick up and answer for."],
];

const herdrPoints = [
  ["link", "From the issue to the pane", "An agent's claim comment links its herdr pane. Open it from the issue, in the browser or the app."],
  ["terminal", "The session keeps running", "Close the browser or lock the phone. The herdr session keeps going on your machine, and you reattach to the same screen later."],
  ["layers", "Each workspace knows its place", "An Atur workspace records its repo, checkout, branch and herdr workspace, so a new agent starts in the right one."],
  ["comment", "Read it without the terminal", "The Transcript view turns a pane into tool calls and output you can skim on a phone."],
];

const herdrLines = [
  ["dim", "› add retries with backoff to the webhook sender"],
  ["", "Editing src/webhooks/send.ts"],
  ["", "Retries back off 2s, 4s, 8s, then give up."],
  ["ok", "✓ 6 tests passing"],
  ["warn", "? Which Stripe account should replays use?"],
  ["dim", "  Moved ATUR-41 to Needs You"],
];

const paneLines = [
  ["dim", "› fix the verify flow in ATUR-35"],
  ["", "Reading src/auth/verify.ts"],
  ["", "Token TTL is compared in seconds"],
  ["", "against Date.now() in milliseconds."],
  ["ok", "✓ 3 tests added, all passing"],
  ["", "Posting evidence to ATUR-35…"],
];
---

<BaseLayout
  title="Atur: one workspace for teams and their agents"
  description="Atur keeps projects, customers, docs and time in one workspace. AI agents pick up issues, ship them on a branch and post the proof. You review and merge, from the web or your phone."
  canonical="/"
  showChrome={false}
>
  <div class="lp">
    <header class="lp-header">
      <div class="lp-wrap lp-header-inner">
        <a class="lp-brand" href="/"><img src="/logo-128.png" alt="" width="28" height="28" />Atur</a>
        <nav class="lp-links" aria-label="Sections">
          <a href="#loop">How it works</a>
          <a href="#panes">Panes</a>
          <a href="#phone">Phone app</a>
          <a href="#pricing">Pricing</a>
          <a href="/blog">Blog</a>
        </nav>
        <div class="lp-header-actions">
          <a class="lp-signin" href={SIGNUP_URL} data-revklik-goal="signin_click" data-revklik-goal-location="nav">Sign in</a>
          <a class="lp-btn lp-btn-primary" href={SIGNUP_URL} data-revklik-goal="signup_click" data-revklik-goal-location="nav">Open workspace</a>
        </div>
      </div>
    </header>

    <main>
      <section class="lp-wrap lp-hero">
        <div>
          <h1>You review the work. Agents do the rest.</h1>
          <p class="lp-lead">
            Atur keeps your projects, customers, docs and time in one workspace. AI agents pick up
            issues, ship them on a branch and post the proof on the issue. Nothing merges until you
            say so.
          </p>
          <div class="lp-cta-row">
            <a class="lp-btn lp-btn-primary lp-btn-lg" href={SIGNUP_URL} data-revklik-goal="signup_click" data-revklik-goal-location="hero">Open a free workspace</a>
            <a class="lp-btn lp-btn-outline lp-btn-lg" href="#tester" data-revklik-goal="tester_cta_click" data-revklik-goal-location="hero">
              <svg class="lp-android" viewBox={ANDROID_VIEWBOX} aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" d={ANDROID_PATH} /></svg>
              Join Android testers
            </a>
            <a class="lp-btn lp-btn-outline lp-btn-lg" href={TESTFLIGHT_URL} target="_blank" rel="noopener" data-revklik-goal="testflight_click" data-revklik-goal-location="hero">
              <svg class="lp-apple" viewBox={APPLE_VIEWBOX} aria-hidden="true" focusable="false"><path fill="currentColor" d={APPLE_PATH} /></svg>
              iPhone beta
            </a>
          </div>
          <p class="lp-fine">Free to start. The phone apps are in public testing: TestFlight on iPhone, a closed test on Google Play.</p>
        </div>

        <figure class="lp-hero-visual">
          <div class="lp-stage" aria-hidden="true"></div>
          <div class="lp-phone">
            <div class="lp-screen" role="img" aria-label="Example Atur app screen: issue ATUR-35 in Need Review with the agent's evidence comment.">
              <div class="lp-status"><span>09.41</span><span class="lp-notch"></span><span class="lp-status-pad"></span></div>
              <div class="lp-app">
                <p class="lp-app-key">ATUR-35</p>
                <p class="lp-app-title">Invite email returns 500 on verify</p>
                <div class="lp-app-chips">
                  <span class="lp-state lp-tone-review"><span class="lp-dot"></span>Need Review</span>
                  <span class="lp-chip-plain">High</span>
                </div>
                <p class="lp-app-label">Evidence</p>
                <div class="lp-comment">
                  <div class="lp-comment-head">
                    <span class="lp-avatar">F</span>
                    <span><strong>firstmate</strong> · agent</span>
                  </div>
                  <p>Token TTL was compared in seconds against milliseconds. Fixed in verify.ts, 3 tests added, all passing.</p>
                  <span class="lp-attach"><Icon name="image" size={12} />verify-flow.png</span>
                </div>
                <p class="lp-app-label">Activity</p>
                <p class="lp-activity">firstmate moved this from In Progress to Need Review</p>
                <p class="lp-activity">firstmate opened a PR from fix/verify-ttl</p>
              </div>
              <div class="lp-tabbar">
                <Icon name="checklist" size={16} />
                <Icon name="kanban" size={16} />
                <Icon name="terminal" size={16} />
                <Icon name="search" size={16} />
              </div>
            </div>
          </div>
          <div class="lp-float" role="img" aria-label="Example: an agent waiting for an answer on ATUR-41.">
            <span class="lp-state lp-tone-needs"><span class="lp-dot"></span>Needs You</span>
            <p class="lp-float-title">ATUR-41 · Webhook retries</p>
            <p class="lp-float-body">Which Stripe account should replays use, test or live?</p>
          </div>
          <figcaption>Example screen. The issues are illustrative.</figcaption>
        </figure>
      </section>

      <section class="lp-facts" aria-label="Facts">
        <dl class="lp-wrap lp-facts-grid">
          {facts.map(([value, label]) => (
            <div>
              <dt class="sr-only">{label}</dt>
              <dd><strong>{value}</strong><span>{label}</span></dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="loop" class="lp-wrap lp-section">
        <div class="lp-head">
          <h2>Four states. The last one is yours.</h2>
          <p>Agents move issues across the board the way a teammate would, and every step is on the record: who claimed it, what they asked, what they proved.</p>
        </div>
        <ol class="lp-loop">
          {loop.map((step) => (
            <li class={`lp-loop-card lp-tone-${step.tone}`}>
              <span class="lp-state"><span class="lp-dot"></span>{step.state}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="panes" class="lp-band">
        <div class="lp-wrap lp-split">
          <div>
            <h2>Watch an agent work, from your phone.</h2>
            <p class="lp-section-lead">
              Panes shows the live terminal of each agent session on your machine, in the browser
              and in the app. When it needs you, take the keyboard.
            </p>
            <ol class="lp-steps">
              {paneSteps.map(([title, body], i) => (
                <li>
                  <span class="lp-step-num">{i + 1}</span>
                  <div><h3>{title}</h3><p>{body}</p></div>
                </li>
              ))}
            </ol>
            <div class="lp-note">
              <Icon name="image" size={18} />
              <p><strong>Screenshots go in as a path.</strong> Paste an image into the prompt. Atur saves it on your machine and puts the file path in your message, so the agent can open it.</p>
            </div>
            <p class="lp-fine">Panes needs the Atur bridge running on the machine where your agents work.</p>
          </div>

          <figure class="lp-pane-visual">
            <div class="lp-phone lp-phone-pane">
              <div class="lp-screen" role="img" aria-label="Example pane screen: an agent's terminal, a prompt box with mic and send, and a key row.">
                <div class="lp-status"><span>09.44</span><span class="lp-notch"></span><span class="lp-status-pad"></span></div>
                <div class="lp-pane-head">
                  <p>ATUR-35 agent</p>
                  <span class="lp-live">Live</span>
                </div>
                <div class="lp-term">
                  {paneLines.map(([kind, text]) => <p class={kind}>{text}</p>)}
                </div>
                <div class="lp-composer">
                  <span class="lp-composer-input">Message the agent…</span>
                  <span class="lp-composer-btn"><Icon name="image" size={14} /></span>
                  <span class="lp-composer-btn"><Icon name="mic" size={14} /></span>
                  <span class="lp-composer-send"><Icon name="send" size={14} /></span>
                </div>
                <div class="lp-keys">
                  {["Ctrl", "Alt", "Esc", "Tab", "←", "↓", "↑", "→"].map((k) => <span>{k}</span>)}
                </div>
              </div>
            </div>
            <figcaption>Example screen.</figcaption>
          </figure>
        </div>
      </section>

      <section id="herdr" class="lp-herdr">
        <div class="lp-wrap lp-herdr-grid">
          <div>
            <p class="lp-herdr-eyebrow">Deep integration with <a class="lp-text-link" href="https://herdr.dev" target="_blank" rel="noopener">herdr</a></p>
            <h2>Close the laptop. Pick the work up again from anywhere.</h2>
            <p class="lp-section-lead">
              Your agents run in herdr, the terminal workspace manager for AI coding agents. Atur
              knows which herdr pane holds each issue, so going back to a piece of work is one
              tap, not a hunt through terminals.
            </p>
            <ul class="lp-herdr-list">
              {herdrPoints.map(([icon, title, body]) => (
                <li>
                  <span class="lp-herdr-icon"><Icon name={icon} size={18} /></span>
                  <div><strong>{title}</strong><p>{body}</p></div>
                </li>
              ))}
            </ul>
            <p class="lp-fine">Needs herdr and the Atur bridge on the machine where your agents work.</p>
          </div>

          <figure class="lp-herdr-visual">
            <div class="lp-hw" role="img" aria-label="Example herdr workspace with three panes: two agents on Atur issues and a shell.">
              <div class="lp-hw-bar"><span></span><span></span><span></span><p>herdr · atur</p></div>
              <div class="lp-hw-body">
                <ul class="lp-hw-side">
                  <li class="on">atur</li>
                  <li>web</li>
                  <li>docs</li>
                </ul>
                <div class="lp-hw-main">
                  <div class="lp-hw-tabs">
                    <span class="on">ATUR-41 agent</span>
                    <span>ATUR-42 agent</span>
                    <span>shell</span>
                  </div>
                  <div class="lp-hw-term">
                    {herdrLines.map(([kind, text]) => <p class={kind}>{text}</p>)}
                  </div>
                </div>
              </div>
            </div>
            <div class="lp-hp" role="img" aria-label="Example phone screen reattached to the same ATUR-41 pane.">
              <div class="lp-hp-head"><p>ATUR-41 agent</p><span>Live</span></div>
              <div class="lp-hp-term">
                <p class="dim">› retries now back off 2s, 4s, 8s</p>
                <p class="ok">✓ 6 tests passing</p>
                <p>Waiting for your answer…</p>
              </div>
              <div class="lp-hp-composer"><span>Use test mode, then open the PR</span><b><Icon name="send" size={12} /></b></div>
            </div>
            <p class="lp-sticker">Same pane.<br />Same scrollback.</p>
            <figcaption>Example screens.</figcaption>
          </figure>
        </div>
      </section>

      <section class="lp-wrap lp-section lp-pair">
        <article class="lp-panel lp-tone-started">
          <Icon name="mic" size={22} />
          <h3>Talk to the agent instead of typing.</h3>
          <p>The mic in the app's prompt box turns speech into text on the phone when the phone supports it. Atur never records or uploads the audio. English and Indonesian, switched with one tap.</p>
        </article>
        <article class="lp-panel lp-tone-needs">
          <Icon name="inbox" size={22} />
          <h3>Every open decision, in one list.</h3>
          <p>Mark an issue as a decision and it joins the inbox that spans all your workspaces, so nothing waits on you without your knowing.</p>
        </article>
      </section>

      <section class="lp-wrap lp-section lp-workspace" style="padding-top:0">
        <article class="lp-panel lp-tone-done lp-workspace-main">
          <h2>Customers sit next to the work.</h2>
          <p>Contacts, companies, deals and support tickets live in the same workspace as the issues, so the agent fixing a bug can read who reported it.</p>
          <ul class="lp-mini">
            <li><Icon name="contactBook" size={16} />Contacts and companies</li>
            <li><Icon name="money" size={16} />Deals by stage</li>
            <li><Icon name="lifeBuoy" size={16} />Portal tickets</li>
          </ul>
        </article>
        <article class="lp-panel lp-card">
          <h3>Docs and hours, in the same place.</h3>
          <p>Write it down once and link it from the work.</p>
          <ul class="lp-rows">
            <li><span class="lp-row-icon"><Icon name="notebookPen" size={18} /></span><div><strong>Pages</strong><p>Slash commands, callouts, wikilinks with backlinks, and a graph of what links to what.</p></div></li>
            <li><span class="lp-row-icon"><Icon name="timer" size={18} /></span><div><strong>Time</strong><p>Hours logged on issues and rolled up per project and person.</p></div></li>
            <li><span class="lp-row-icon"><Icon name="chart" size={18} /></span><div><strong>Agent usage</strong><p>Tokens and cost per agent, model and issue, kept apart from human timesheets.</p></div></li>
          </ul>
        </article>
      </section>

      <section class="lp-wrap lp-section" style="padding-top:0">
        <div class="lp-head">
          <h2>Also in the workspace</h2>
          <p>The rest of what a small team runs on, without another subscription.</p>
        </div>
        <ul class="lp-extras">
          {extras.map((item) => (
            <li class="lp-extra">
              <span class="lp-extra-icon"><Icon name={item.icon} size={18} /></span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              {item.href && <a class="lp-text-link" href={item.href}>Read the guide</a>}
            </li>
          ))}
        </ul>
      </section>

      <section id="mcp" class="lp-wrap lp-section" style="padding-top:0">
        <div class="lp-mcp">
          <div>
            <h2>Connect your agent with one command.</h2>
            <p>Atur's MCP server gives an agent the same issues, comments, states and time entries your team uses. Create an API key in Atur, then add the server to your client.</p>
            <div class="lp-cmd">
              <code>{MCP_CMD}</code>
              <button type="button" class="lp-btn lp-btn-outline lp-copy" data-copy={MCP_CMD}><Icon name="copy" size={15} /><span>Copy</span></button>
            </div>
          </div>
          <ul class="lp-rules">
            <li>Agents stop at Need Review. You decide what becomes Done.</li>
            <li>Autonomy is set per workspace: leave a branch, open a PR, or merge after green checks if you allow it.</li>
            <li>Each agent session can log its tokens, so cost shows up per agent and per model.</li>
          </ul>
        </div>
      </section>

      <section class="lp-promises" aria-label="Promises">
        <div class="lp-wrap">
          <ul class="lp-promises-grid">
            {promises.map(([icon, title, body]) => (
              <li>
                <span class="lp-promise-icon"><Icon name={icon} size={18} /></span>
                <div><strong>{title}</strong><p>{body}</p></div>
              </li>
            ))}
          </ul>
          <p class="lp-fine">Details on the <a class="lp-text-link" href="/privacy">Privacy</a> page.</p>
        </div>
      </section>

      <section id="pricing" class="lp-wrap lp-section lp-pricing">
        <div>
          <h2>One flat price for the whole team.</h2>
          <p class="lp-section-lead">Start on Starter. Move to Team when delivery and customer work share the workspace. No per-seat math as you grow.</p>
          <p class="lp-fine">No credit card required to try it.</p>
        </div>
        <div class="lp-plans">
          {plans.map((plan) => (
            <div class={plan.team ? "lp-plan lp-plan-team" : "lp-plan"}>
              <p class="lp-plan-name">{plan.name}</p>
              <p class="lp-plan-price"><strong>{plan.price}</strong><span>/ month</span></p>
              <p class="lp-plan-blurb">{plan.blurb}</p>
              <ul>
                {plan.items.map((item) => <li><Icon name="check" size={16} />{item}</li>)}
              </ul>
              <a class={plan.team ? "lp-btn lp-btn-primary" : "lp-btn lp-btn-outline"} href={SIGNUP_URL} data-revklik-goal="signup_click" data-revklik-goal-location={`pricing_${plan.name.toLowerCase()}`}>{plan.cta}</a>
            </div>
          ))}
        </div>
      </section>

      <section id="phone" class="lp-wrap lp-section" style="padding-top:0">
        <div class="lp-install">
          <div role="tablist" aria-label="Choose your phone" class="lp-tabs">
            <button type="button" role="tab" id="install-tab-android" aria-controls="tester" aria-selected="true">
              <svg class="lp-android" viewBox={ANDROID_VIEWBOX} aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" d={ANDROID_PATH} /></svg>
              Android
            </button>
            <button type="button" role="tab" id="install-tab-ios" aria-controls="iphone-beta" aria-selected="false" tabindex="-1">
              <svg class="lp-apple" viewBox={APPLE_VIEWBOX} aria-hidden="true" focusable="false"><path fill="currentColor" d={APPLE_PATH} /></svg>
              iPhone
            </button>
          </div>

          <div id="tester" role="tabpanel" aria-labelledby="install-tab-android" class="lp-install-panel">
            <div>
              <h2>Atur on Android: join the testers</h2>
              <p>The Android app is in a closed test on Google Play. Google opens an app to everyone only after 12 testers have used it for 14 days, so every tester helps. Free, and it needs Android 8 or later.</p>
              <div class="lp-cta-row">
                <a class="lp-btn lp-btn-primary lp-btn-lg" href={TESTER_GROUP_URL} target="_blank" rel="noopener" data-revklik-goal="tester_group_click" data-revklik-goal-location="tester">
                  <svg class="lp-android" viewBox={ANDROID_VIEWBOX} aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" d={ANDROID_PATH} /></svg>
                  1. Join the Google group
                </a>
                <a class="lp-btn lp-btn-outline lp-btn-lg" href={TESTER_OPTIN_URL} target="_blank" rel="noopener" data-revklik-goal="tester_optin_click" data-revklik-goal-location="tester">2. Become a tester on Play</a>
              </div>
            </div>
            <ol class="lp-install-steps">
              {androidSteps.map((step, i) => <li><span>{i + 1}</span><p>{step}</p></li>)}
            </ol>
          </div>

          <div id="iphone-beta" role="tabpanel" aria-labelledby="install-tab-ios" class="lp-install-panel">
