---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import "../styles/landing.css";

const APP_URL = "https://app.diatur.com";

const boardCols = [
  {
    name: "Backlog",
    dot: "var(--lp-text-3)",
    count: "3",
    cards: [
      { key: "ATUR-41", title: "Add webhook retries with backoff", chip: null },
      { key: "ATUR-44", title: "Draft v0.9 changelog", chip: { kind: "gray", icon: "bot", text: "queued" } },
    ],
  },
  {
    name: "In progress",
    dot: "var(--lp-blue)",
    count: "2 · WIP 3",
    cards: [
      { key: "ATUR-38", title: "Rate-limit login attempts", chip: { kind: "green", icon: "terminal", text: "firstmate · working" } },
      { key: "ATUR-39", title: "Fix OAuth callback race", chip: { kind: "green", icon: "terminal", text: "sonnet · working" } },
    ],
  },
  {
    name: "Needs review",
    dot: "var(--lp-amber)",
    count: "2",
    hot: true,
    cards: [
      { key: "ATUR-35", title: "Invite email returns 500 on verify", chip: { kind: "amber", icon: "checkmarkCircle", text: "evidence ready" } },
      { key: "ATUR-33", title: "Migrate assets to R2", chip: { kind: "amber", icon: "checkmarkCircle", text: "evidence ready" } },
    ],
  },
  {
    name: "Done",
    dot: "var(--lp-green)",
    count: "12",
    cards: [
      { key: "ATUR-28", title: "Cycle burndown chart", chip: { kind: "green", icon: "gitMerge", text: "merged · dzul" } },
      { key: "ATUR-26", title: "Portal ticket threading", chip: { kind: "green", icon: "gitMerge", text: "merged · dzul" } },
    ],
  },
];

const metrics = [
  ["70+", "MCP tools for agents"],
  ["1", "connected workspace"],
  ["0", "unreviewed merges"],
  ["24/7", "agents on shift"],
];

const steps = [
  ["Write it like a brief", "Link the repo, the customer, the page. The issue carries everything an agent needs, with no context lost in a handoff."],
  ["An agent picks it up", "It claims the issue and ships in an isolated branch. Its live terminal is one click away in your browser. No black box."],
  ["You review the proof", "What changed and why it works land on the issue as evidence. Approve and merge. Nothing ships without you."],
];

const groups = [
  {
    icon: "kanban",
    title: "Plan & ship",
    rows: [
      ["kanban", "Projects, issues, and cycles"],
      ["gitBranch", "Agent work on branches, proof on issues"],
      ["timer", "Time tracked where work happens"],
    ],
  },
  {
    icon: "contactBook",
    title: "Keep customers close",
    rows: [
      ["contactBook", "Contacts, companies, and pipeline"],
      ["lifeBuoy", "Support portal and feedback board"],
      ["chart", "Reports that follow projects"],
    ],
  },
  {
    icon: "file",
    title: "Remember everything",
    rows: [
      ["notebookPen", "Pages with slash commands and callouts"],
      ["link", "Wikilinks with backlinks"],
      ["flow", "A knowledge graph of the work"],
    ],
  },
];

const reasons = [
  ["gitPullRequest", "Agents never merge", "Every agent task ends at Need Review. What changed and the proof sit on the issue, and only a human clicks merge."],
  ["comment", "A blocked agent asks", "Missing a credential or a decision? It moves the issue to Needs You and comments exactly what it needs. Answer, and it resumes."],
  ["slidersHorizontal", "Autonomy you set", "Per workspace: leave a branch, open a PR, or (only if you say so) merge after green checks. Widen it deliberately."],
];

const surfaces = [
  ["issues", "var(--lp-green)"],
  ["tickets", "var(--lp-blue)"],
  ["deals", "var(--lp-amber)"],
  ["time", "var(--lp-text-3)"],
  ["pages", "var(--lp-text-3)"],
];

const termLines: [string, string, string][] = [
  ["$", "# claude mcp add atur --transport http \\", "cmd"],
  ["", "    https://app.diatur.com/mcp \\", "cmd"],
  ["", "    -H \"X-API-Key: pk_live_…\"", "cmd"],
  ["", "", "dim"],
  ["#", "# 70+ tools. one connected data model.", "dim"],
  ["", "", "dim"],
  ["$", "atur claim ATUR-41 --agent firstmate", "cmd"],
  ["✓", "claimed · branch feat/webhook-retries · pane wJ:pJ", "ok"],
  ["→", "evidence will post to the issue at Need Review", "dim"],
];

const MCP_CMD = "claude mcp add atur --transport http https://app.diatur.com/mcp -H \"X-API-Key: <your-key>\"";

const compareRows = [
  ["issues & cycles", "linear or jira: $8–10/seat", "✓ built in"],
  ["agent execution", "nothing ships proof", "✓ claims, ships, posts evidence"],
  ["pages & graph", "notion: $10/seat", "✓ wikilinks + knowledge graph"],
  ["crm & portal", "hubspot + zendesk", "✓ deals, contacts, support portal"],
  ["time", "toggl: $9/seat", "✓ rolled up per issue"],
  ["price model", "per-seat, grows with you", "✓ flat: team $29/mo"],
];

const posts = [
  ["origin", "why-we-built-atur", "Why we built Atur", "Small teams don't fail from lack of tools. They fail from context scattered across too many of them, and now agents inherit that mess."],
  ["comparison", "atur-vs-linear", "Atur vs Linear", "Linear made issues fast. Atur makes issues something an agent can pick up, ship, and answer for, with the review still yours."],
  ["engineering", "how-atur-is-built", "How Atur is built", "One Hono worker on Cloudflare, one D1 database, and an MCP server that exposes the same data model your team uses."],
];

const plans = [
  {
    name: "Starter",
    price: "$9",
    blurb: "For individuals and small teams building a calmer operating system.",
    items: ["Projects, issues, and cycles", "Support portal and feedback", "CRM contacts and pipeline", "Pages and knowledge graph", "Time tracking", "AI agents via MCP"],
    hot: false,
  },
  {
    name: "Team",
    price: "$29",
    blurb: "For growing teams bringing delivery and customer work together.",
    items: ["Everything in Starter", "Flat price: the whole team, not per seat", "Custom domain", "Daily automatic backups", "Priority support", "Onboarding assistance"],
    hot: true,
  },
];
---

<BaseLayout
  title="Atur: one workspace for teams and their agents"
  description="Atur connects projects, customers, docs, and time in one workspace, and gives your AI agents 70+ MCP tools to ship real work, with evidence on every issue and a human holding the merge."
  canonical="/"
  showChrome={false}
>
  <div class="lp">
    <nav class="lp-nav">
      <a class="lp-brand" href="/"><img src="/logo-128.png" alt="" width={30} height={30} />Atur</a>
      <div class="lp-links">
        <a href="#mcp">Product</a>
        <a href="#agents">Agents</a>
        <a href="#pricing">Pricing</a>
        <a href="/blog">Blog</a>
      </div>
      <div class="lp-nav-actions">
        <a class="signin" href={`${APP_URL}/auth/login`}>Sign in</a>
        <a class="lp-btn" href={`${APP_URL}/auth/login`}>Open workspace <Icon name="arrowRight" size={15} class="i" /></a>
      </div>
    </nav>

    <header class="lp-hero">
      <h1>You review the work.</h1>
      <p class="h1-serif">the agents do the rest.</p>
      <p class="sub">
        Atur runs your whole operation (projects, customers, docs, time) and your AI agents work
        the board like teammates: they claim issues, ship them, and post the evidence. Nothing
        merges without you.
      </p>
      <div class="lp-hero-ctas">
        <a class="lp-btn lp-btn-lg" href={`${APP_URL}/auth/login`}>Start free <Icon name="arrowRight" size={17} class="i" /></a>
        <a class="lp-btn lp-btn-lg lp-btn-ghost" href="#agents">See how agents work <Icon name="arrowDown" size={16} class="i" /></a>
      </div>

      <div class="lp-proof">
        <div class="lp-proof-chrome">
          <span class="url">app.diatur.com / joyodigitama / Q3 Launch</span>
          <span class="spacer"></span>
          <span class="lp-live-chip"><span class="lp-dot"></span>2 agents working</span>
        </div>
        <div class="lp-board">
          {boardCols.map((col) => (
            <div class="lp-col">
              <div class="lp-col-head">
                <span class="cdot" style={`background:${col.dot}`}></span>
                <span class="name">{col.name}</span>
                <span class="count">{col.count}</span>
              </div>
              {col.cards.map((card) => (
                <div class="lp-card" style={col.hot && card.chip?.kind === "amber" ? "border-color:var(--lp-amber)" : ""}>
                  <span class="key">{card.key}</span>
                  <span class="title">{card.title}</span>
                  {card.chip && (
                    <span class={`lp-chip ${card.chip.kind}`}><Icon name={card.chip.icon} size={11} />{card.chip.text}</span>
                  )}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>

      <div class="lp-metrics">
        {metrics.map(([v, l]) => (
          <div class="lp-stat"><strong>{v}</strong><span>{l}</span></div>
        ))}
      </div>
    </header>

    <section id="agents" class="lp-section">
      <div class="wrap">
        <div class="lp-section-head">
          <div class="lp-eyebrow-row">
            <span class="lp-eyebrow-label">THE AGENT LOOP</span>
            <span class="lp-eyebrow-line"></span>
          </div>
          <h2 class="lp-h2">From issue to shipped,</h2>
          <p class="lp-h2-serif">with a human at the wheel.</p>
          <p class="lp-section-sub">
            Agents work your board like teammates. They claim the issue, ship it in a branch, and
            post the evidence. The merge stays yours.
          </p>
        </div>
        <div class="lp-steps">
          {steps.map(([title, body], i) => (
            <article class="lp-step">
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
        <div class="lp-flow">
          <span class="lp-flow-pill blue"><span class="lp-dot"></span>In progress</span>
          <Icon name="arrowRight" size={16} class="lp-flow-sep" />
          <span class="lp-flow-pill amber"><span class="lp-dot"></span>Need review</span>
          <Icon name="arrowRight" size={16} class="lp-flow-sep" />
          <span class="lp-flow-pill green"><span class="lp-dot"></span>Done</span>
        </div>
      </div>
    </section>

    <section class="lp-section elevated">
      <div class="wrap">
        <div class="lp-section-head">
          <div class="lp-eyebrow-row">
            <span class="lp-eyebrow-label">ONE CONNECTED WORKSPACE</span>
            <span class="lp-eyebrow-line"></span>
          </div>
          <h2 class="lp-h2">Everything your team needs,</h2>
          <p class="lp-h2-serif">connected for small teams.</p>
          <p class="lp-section-sub">
            Work that doesn't fit one tool shouldn't need five. Bring delivery, customers, docs, and
            time together, for the team and the agents they put to work on it.
          </p>
        </div>
        <div class="lp-groups">
          {groups.map((g) => (
            <article class="lp-group">
              <span class="ic"><Icon name={g.icon} size={19} /></span>
              <h3>{g.title}</h3>
              <ul>
                {g.rows.map(([ic, text]) => (
                  <li><Icon name={ic} size={14} />{text}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-section">
      <div class="wrap">
        <div class="lp-control-panel">
          <span class="eyebrow">WHY ATUR</span>
          <div class="lp-control-h2">
            <h2 class="lp-h2">Agent speed,</h2>
            <p class="lp-h2-serif">human judgment.</p>
          </div>
          <div class="lp-reasons">
            {reasons.map(([icon, title, body]) => (
              <div class="lp-reason">
                <Icon name={icon} size={20} />
                <h3>{title}</h3>
                <p>{body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="mcp" class="lp-section" style="padding-top:0">
      <div class="lp-mcp">
        <div class="lp-mcp-left">
          <div class="lp-eyebrow-row">
            <span class="lp-eyebrow-num">01</span>
            <span class="lp-eyebrow-label">MCP NATIVE</span>
            <span class="lp-eyebrow-line"></span>
          </div>
          <h2 class="lp-h2">One agent,</h2>
          <p class="lp-h2-serif">the whole operation.</p>
          <p class="body">
            Atur ships an MCP server with 70+ tools over one connected data model: issues, tickets,
            deals, time, pages. Scope an agent to a project; every action it takes is an auditable
            record.
          </p>
          <div class="lp-surface-chips">
            {surfaces.map(([name, color]) => (
              <span class="lp-surface-chip"><span class="lp-dot" style={`background:${color}`}></span>{name}</span>
            ))}
          </div>
          <div class="lp-meta-row">
            <span class="lp-meta"><strong>70+</strong><span>tools</span></span>
            <span class="lp-meta-sep"></span>
            <span class="lp-meta"><strong>1</strong><span>connected model</span></span>
            <span class="lp-meta-sep"></span>
            <span class="lp-meta audit"><Icon name="shieldCheck" size={14} /><span>auditable</span></span>
          </div>
        </div>
        <div class="lp-term">
          <div class="lp-term-chrome">
            <div class="left">
              <span class="tdot" style="background:#ff5f57"></span>
              <span class="tdot" style="background:#febc2e"></span>
              <span class="tdot" style="background:#28c840"></span>
              <span class="title">agent setup: zsh</span>
            </div>
            <span class="compat"><span class="lp-dot" style="background:var(--lp-green)"></span>claude • cursor • windsurf</span>
          </div>
          <div class="lp-term-body">
            {termLines.map(([p, t, kind]) => (
              <div class="lp-term-line">
                <span class={`p ${p === "$" || p === "✓" ? "ok" : ""}`}>{p}</span>
                <span class={`t ${kind === "dim" ? "dim" : ""}`}>{t}</span>
              </div>
            ))}
          </div>
          <div class="lp-term-foot">
            <div class="left">
              <span class="icon-box"><Icon name="shieldCheck" size={12} /></span>
              <span class="kv">
                <span class="k">Scoped to one project</span>
                <span class="v">Agent only sees what you scope it to</span>
              </span>
            </div>
            <button class="lp-copy-btn" data-copy={MCP_CMD} type="button">
              <Icon name="copy" size={12} />Copy
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="pricing" class="lp-section" style="padding-top:0">
      <div class="wrap">
        <div class="lp-section-head">
          <div class="lp-eyebrow-row">
            <span class="lp-eyebrow-label">PRICING</span>
            <span class="lp-eyebrow-line"></span>
          </div>
          <h2 class="lp-h2">A flat price,</h2>
          <p class="lp-h2-serif">not a per-seat tax.</p>
          <p class="lp-section-sub">
            Simple plans for a connected workspace. Pay one flat rate for the whole team. No
            per-seat math as you grow.
          </p>
        </div>
        <div class="lp-plans">
          {plans.map((plan) => (
            <article class={`lp-plan${plan.hot ? " hot" : ""}`}>
              {plan.hot && <span class="tag">FOR GROWING TEAMS</span>}
              <h3>{plan.name}</h3>
              <div class="price"><strong>{plan.price}</strong><span>/ month</span></div>
              <p class="blurb">{plan.blurb}</p>
              <ul>
                {plan.items.map((item) => (
                  <li><Icon name="check" size={14} />{item}</li>
                ))}
              </ul>
              <a class="plan-btn" href={`${APP_URL}/auth/login`}>Start with {plan.name}</a>
            </article>
          ))}
        </div>
        <p class="lp-reassure">No credit card required to try it.</p>
      </div>
    </section>

    <section class="lp-section" style="padding-top:0">
      <div class="wrap">
        <div class="lp-section-head" style="align-items:flex-start;text-align:left">
          <div class="lp-eyebrow-row">
            <span class="lp-eyebrow-num">02</span>
            <span class="lp-eyebrow-label">THE STACK IT REPLACES</span>
            <span class="lp-eyebrow-line"></span>
          </div>
          <h2 class="lp-h2" style="font-size:30px;letter-spacing:-1px">Five subscriptions, one flat workspace.</h2>
        </div>
        <div class="lp-compare">
          {compareRows.map(([surface, stack, atur], i) => (
            <div class={`lp-compare-row${i === 0 ? " head" : ""}`}>
              <span class="a">{surface}</span>
              <span class="b">{stack}</span>
              <span class={`c${i === 0 ? "" : " mono"}`}>{atur}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-section" style="padding-top:0;padding-bottom:96px">
      <div class="wrap">
        <div class="lp-blog-head">
          <div class="lp-eyebrow-row">
            <span class="lp-eyebrow-num">03</span>
            <span class="lp-eyebrow-label">FROM THE BUILD LOG</span>
            <span class="lp-eyebrow-line"></span>
          </div>
          <a class="all" href="/blog">read the blog →</a>
        </div>
        <div class="lp-blog-cards">
          {posts.map(([tag, slug, title, ex]) => (
            <a class="lp-post" href={`/blog/${slug}`}>
              <span class="ptag">{tag}</span>
              <h3>{title}</h3>
              <p>{ex}</p>
              <span class="go">read →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-section" style="padding-top:0">
      <div class="wrap">
        <div class="lp-cta-panel">
          <span class="eyebrow">04 · START</span>
          <h2>Give your work</h2>
          <p class="h2-serif">one place to land.</p>
          <p>
            Open a workspace, bind your repos, and give an agent its first issue. You keep the
            review, and it takes the busywork.
          </p>
          <a class="lp-btn lp-btn-lg" href={`${APP_URL}/auth/login`}>Open Atur <Icon name="arrowRight" size={16} class="i" /></a>
        </div>
      </div>
    </section>

    <footer class="lp-footer">
      <a class="brand" href="/"><img src="/logo-128.png" alt="" width={22} height={22} />Atur</a>
      <nav>
        <a href="#mcp">Product</a>
        <a href="#agents">Agents</a>
        <a href="#pricing">Pricing</a>
        <a href="/blog">Blog</a>
      </nav>
      <span class="copy">© 2026 Atur</span>
    </footer>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".lp-copy-btn").forEach((btn) => {
    const setLabel = (text: string) => {
      const label = btn.lastChild;
      if (label && label.nodeType === 3) label.textContent = text;
    };
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
        setLabel(" Copied");
        setTimeout(() => setLabel("Copy"), 1600);
      } catch {
        setLabel(" Copy failed");
        setTimeout(() => setLabel("Copy"), 1600);
      }
    });
  });
</script>
