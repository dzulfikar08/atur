<script>
  document.querySelectorAll<HTMLButtonElement>(".lp-copy").forEach((btn) => {
    const label = btn.querySelector("span");
    if (!label) return;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        label.textContent = "Copied";
      } catch {
        label.textContent = "Copy failed";
      }
      setTimeout(() => (label.textContent = "Copy"), 1600);
    });
  });

  // Phone install tabs (ARIA tabs pattern). Both panels ship visible in the
  // HTML so they work without JS; this hides the inactive one. The visitor's
  // phone picks the first tab; #tester and #iphone-beta pick it explicitly.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".lp-tabs [role=tab]")];
  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls") ?? "")?.toggleAttribute("hidden", !on);
    }
    if (focus) tab.focus();
  };
  const byPanel = (id: string) => tabs.find((t) => t.getAttribute("aria-controls") === id);
  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      select(tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length], true);
    });
  });
  const fromHash = () => {
    const id = location.hash.slice(1);
    const tab = byPanel(id);
    if (!tab) return;
    select(tab);
    // The panel was hidden when the browser jumped; land on the section so the tabs stay in view.
    document.getElementById("phone")?.scrollIntoView();
  };
  const ios = /iPhone|iPad|iPod/.test(navigator.userAgent);
  const first = byPanel(ios ? "iphone-beta" : "tester");
  if (first) select(first);
  fromHash();
  window.addEventListener("hashchange", fromHash);
</script>
